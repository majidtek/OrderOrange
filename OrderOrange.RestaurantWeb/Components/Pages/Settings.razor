                        private int _photoPct = -1;

                        /// <summary>Slices cross the bridge 50KB at a time; the bar narrates the trip.</summary>
                        private async Task<string?> PullChunks(string id, int size)
                            {
                                var sb = new System.Text.StringBuilder(size);
                                for (var offset = 0; offset < size; offset += 50000)
                                {
                                    sb.Append(await JS.InvokeAsync<string>("mfBlob.chunk", id, offset, 50000));
                                        _photoPct = (int)Math.Min(99, (offset + 50000) * 100L / size);
                                        StateHasChanged();
                                    }
                                    await JS.InvokeVoidAsync("mfBlob.end", id);
                                    return sb.Length == size ? sb.ToString() : null;
                                }

                                private bool _uploadingLogo;
                                private string? _logoData;

                                /// <summary>The shop's emoji comes from the same picker the products use.</summary>
                                private async Task PickLogoEmoji()
                                {
                                    var parameters = new DialogParameters<EmojiPickerDialog> { { d => d.Current, _logoEmoji } };
                                        var dialog = await Dialogs.ShowAsync<EmojiPickerDialog>("", parameters,
                                            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true });
                                            var result = await dialog.Result;
                                            if (result?.Canceled == false && result.Data is string picked) _logoEmoji = picked;
                                        }

                                        /// <summary>Picks, compresses and stores the shop's logo — same bridge as the photos.</summary>
                                        private async Task UploadLogo()
                                        {
                                            _uploadingLogo = true;
                                            try
                                            {
                                                var meta = await JS.InvokeAsync<string?>("mfImage.pick", false, 340000);
                                                    if (string.IsNullOrEmpty(meta)) return;
                                                    if (meta == "huge") { Snackbar.Add(L["common.photoOver5"], Severity.Warning); return; }
                                                    if (meta == "too-big") { Snackbar.Add(L["common.photoTooLarge"], Severity.Warning); return; }
                                                    var parked = System.Text.Json.JsonDocument.Parse(meta);
                                                    var data = await PullChunks(parked.RootElement.GetProperty("id").GetString()!,
                                                    parked.RootElement.GetProperty("size").GetInt32());
                                                    if (string.IsNullOrEmpty(data)) return;
                                                    var (ok, error) = await Api.SetMyStoreLogoAsync(data);
                                                    if (!ok) { Snackbar.Add(error ?? L["common.uploadFail"], Severity.Error); return; }
                                                    _logoData = data;
                                                    Snackbar.Add(L["common.saved"], Severity.Success);
                                                }
                                                finally
                                                {
                                                    _uploadingLogo = false;
                                                    _photoPct = -1;
                                                    StateHasChanged();
                                                }
                                            }

                                            private async Task ClearLogo()
                                            {
                                                var (ok, error) = await Api.SetMyStoreLogoAsync("");
                                                if (!ok) { Snackbar.Add(error ?? L["common.updateFail"], Severity.Error); return; }
                                                _logoData = null;
                                            }

                                            private async Task AddPhoto()
                                            {
                                                _uploadingPhoto = true;
                                                try
                                                {
                                                    // Compressed on-device to fit the store-photo shelf, then pulled in slices.
                                                    var meta = await JS.InvokeAsync<string?>("mfImage.pick", false, 680000);
                                                        if (string.IsNullOrEmpty(meta)) return;
                                                        if (meta == "huge") { Snackbar.Add(L["common.photoOver5"], Severity.Warning); return; }
                                                        if (meta == "too-big") { Snackbar.Add(L["common.photoTooLarge"], Severity.Warning); return; }
                                                        _photoPct = 0;
                                                        var parked = System.Text.Json.JsonDocument.Parse(meta);
                                                        var data = await PullChunks(parked.RootElement.GetProperty("id").GetString()!,
                                                        parked.RootElement.GetProperty("size").GetInt32());
                                                        if (string.IsNullOrEmpty(data)) return;
                                                        var (ok, error) = await Api.AddMyStorePhotoAsync(data);
                                                        if (!ok) { Snackbar.Add(error ?? L["common.uploadFail"], Severity.Error); return; }
                                                        _photos = await Api.GetMyStorePhotosAsync();
                                                    }
                                                    finally
                                                    {
                                                        _uploadingPhoto = false;
                                                        _photoPct = -1;
                                                        StateHasChanged();
                                                    }
                                                }

