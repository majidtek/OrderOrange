                                                                        private CancellationTokenSource? _slugCheckCts;

                                                                        /// <summary>The complete short link, as it should be handed out.</summary>
                                                                        private string FullSlugUrl => $"https://www.orderorange.com/{_slug}";

                                                                        private async Task CopySlugLink()
                                                                        {
                                                                            try
                                                                            {
                                                                                await JS.InvokeVoidAsync("navigator.clipboard.writeText", FullSlugUrl);
                                                                                Snackbar.Add(L["qr.copied"], Severity.Success);
                                                                            }
                                                                            catch (JSException)
                                                                            {
                                                                                Snackbar.Add(FullSlugUrl, Severity.Info);   // clipboard blocked: show it to copy by hand
                                                                            }
                                                                        }

                                                                        private async Task OnSlugTyped(string value)
                                                                        {
                                                                            _slug = (value ?? "").Trim().ToLowerInvariant();
                                                                            _slugSaved = false;
                                                                            _slugStatus = null;
                                                                            if (_slug.Length == 0) return;

                                                                            // Debounced: one availability call after the typing pauses,
                                                                            // not one per keystroke.
                                                                            _slugCheckCts?.Cancel();
                                                                            _slugCheckCts = new CancellationTokenSource();
                                                                            var token = _slugCheckCts.Token;
                                                                            try
                                                                            {
                                                                                await Task.Delay(450, token);
                                                                                var check = await Api.CheckSlugAsync(_slug);
                                                                                if (token.IsCancellationRequested) return;
                                                                                _slugStatus = check is null ? null
                                                                                    : check.Available ? "free"
                                                                                    : check.Reason;
                                                                                StateHasChanged();
                                                                            }
                                                                            catch (TaskCanceledException) { }
                                                                        }

                                                                        private async Task SaveSlug()
                                                                        {
                                                                            var (ok, error) = await Api.SetSlugAsync(_slug);
                                                                            if (ok)
                                                                            {
