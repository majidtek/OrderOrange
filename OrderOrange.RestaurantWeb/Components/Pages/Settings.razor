                                                    private static readonly string[] VerticalCategories = ["Grocery", "Pharmacy", "Flowers & Gifts", "Flowers", "Shopping"];

                                                    /// <summary>Each store type gets its own categories: verticals see theirs, restaurants see food cuisines.</summary>
                                                    private List<CuisineDto> FilteredCuisines
                                                        {
                                                            get
                                                            {
                                                                if (_cuisines is null) return [];
                                                                var filtered = _storeType switch
                                                                {
                                                                    StoreType.Grocery => _cuisines.Where(c => c.Name == "Grocery"),
                                                                    StoreType.Pharmacy => _cuisines.Where(c => c.Name == "Pharmacy"),
                                                                    StoreType.Flowers => _cuisines.Where(c => c.Name is "Flowers & Gifts" or "Flowers"),
                                                                    StoreType.Shop => _cuisines.Where(c => c.Name == "Shopping"),
                                                                    _ => _cuisines.Where(c => !VerticalCategories.Contains(c.Name))
                                                                };
                                                                var list = filtered.ToList();
                                                                return list.Count > 0 ? list : _cuisines; // fresh DB without vertical rows — show everything
                                                            }
                                                        }

