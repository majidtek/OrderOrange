@page "/settings"
@inject ApiClient Api
@inject LanguageService L
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IDialogService Dialogs

<PageTitle>Partner — Settings</PageTitle>

<PageHeader Title="@TypedTitle" Subtitle="@L["partner.storeSettingsSub"]" />

@if (_restaurant is null || _cuisines is null)
{
    <Loader FullPage="true" />
}
else
{
    <div class="st-page" style="max-width: 1100px;">
        <MudGrid Spacing="4">
            <MudItem xs="12" md="7">
                <MudPaper Elevation="0" Outlined="true" Class="pa-5 rounded-xl">
                    <MudText Typo="Typo.h6" Class="mb-4">@L["partner.profile"]</MudText>
                    @* The same open/closed switch the top bar carries — here too, where
                       every other decision about the shop is made. *@
                    <MudSwitch T="bool" Value="_isOpen" ValueChanged="ToggleOpenNow" Color="Color.Success" Size="Size.Small" Class="mb-3"
                               Label="@(_isOpen ? L["partner.open"] : L["partner.closed"])" />
                    @* The TYPE leads: what it is decides what everything below is called. *@
                    <MudSelect T="StoreType" Value="_storeType" ValueChanged="OnStoreTypeChanged" Label="@L["partner.storeType"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                        <MudSelectItem T="StoreType" Value="StoreType.Restaurant">🍔 @L["st.restaurant"]</MudSelectItem>
                        <MudSelectItem T="StoreType" Value="StoreType.Grocery">🛒 @L["st.grocery"]</MudSelectItem>
                        <MudSelectItem T="StoreType" Value="StoreType.Pharmacy">💊 @L["st.pharmacy"]</MudSelectItem>
                        <MudSelectItem T="StoreType" Value="StoreType.Flowers">💐 @L["st.flowers"]</MudSelectItem>
                        <MudSelectItem T="StoreType" Value="StoreType.Shop">🛍️ @L["st.shop"]</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">
                        @string.Format(L["login.typedName"], L[$"st.{_storeType.ToString().ToLowerInvariant()}"])
                    </MudText>
                    <StoreNameFields Value="_names" ValueChanged="OnNamesSaved" />
                    <MudTextField @bind-Value="_description" Label="@L["partner.description"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Class="mb-3" />
                    @* A kitchen is not always one thing — an Iranian grill can be an
                       Arabic one too. Same picker as the add-business wizard: the main
                       type wears the star, further taps add the rest. A vertical store
                       IS its vertical, so it keeps the single-choice picker. *@
                    @if (_storeType == StoreType.Restaurant)
                    {
                        <CuisinePicker @bind-Value="_cuisineId" Label="@L["w.category"]" Class="mb-3"
                            Choices="@FilteredCuisines" Multi="true"
                            ExtraValues="_extraCuisineIds"
                            ExtraValuesChanged="@(v => _extraCuisineIds = v.ToHashSet())" />
                    }
                    else
                    {
                        <CuisinePicker @bind-Value="_cuisineId" Label="@L["w.category"]" Class="mb-3"
                            Choices="@FilteredCuisines" />
                    }
                    @* The real logo. It replaces the emoji everywhere the shop introduces
                    itself, so it is the first thing on this card. *@
                    <div class="oo-logo-row mb-3">
                        <div class="shot">
                            @if (!string.IsNullOrEmpty(_logoData))
                            {
                                <img src="@_logoData" alt="logo" />
                            }
                            else
                            {
                                <span class="em">@(string.IsNullOrWhiteSpace(_logoEmoji) ? "🍽️" : _logoEmoji)</span>
                            }
                        </div>
                        <div class="tx">
                            <b>@L["partner.logo"]</b>
                            <small>@L["partner.logoHint"]</small>
                            <div class="d-flex align-center mt-2" style="gap: 8px; flex-wrap: wrap;">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.Upload" Disabled="_uploadingLogo"
                                    OnClick="UploadLogo">@L["partner.logoUpload"]</MudButton>
                                    @if (!string.IsNullOrEmpty(_logoData))
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                            StartIcon="@Icons.Material.Filled.DeleteOutline" Disabled="_uploadingLogo"
                                            OnClick="ClearLogo">@L["common.delete"]</MudButton>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex" style="gap: 12px;">
                                @* Tapped from the picker, never typed — an emoji keyboard is a
                                different thing on every phone. *@
                                <div @onclick="PickLogoEmoji" style="cursor: pointer; flex: 1;">
                                    <MudTextField Value="@_logoEmoji" T="string" ReadOnly="true" Label="@L["partner.logoEmoji"]"
                                        Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                        Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.EmojiEmotions" />
                                </div>
                                <MudTextField @bind-Value="_bannerColor" Label="@L["partner.bannerColor"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                                    HelperText="@L["partner.hexHint"]" />
                            </div>
                            <div class="d-flex" style="gap: 12px;">
                                <MudTextField @bind-Value="_area" Label="@L["addr.area"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                <MudTextField @bind-Value="_street" Label="@L["addr.street"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                            </div>
                            @for (var i = 0; i < _phoneEntries.Count; i++)
                            {
                                var idx = i;
                                <div class="d-flex align-center mb-3" style="gap: 8px;">
                                    <span class="ph-kind">@(_phoneEntries[idx].IsMobile ? "📱" : "☎️")</span>
                                    <div style="flex: 1;">
                                        <PhoneField Value="@_phoneEntries[idx].Number" ValueChanged="@(v => _phoneEntries[idx].Number = v)"
                                            Label="@(_phoneEntries[idx].IsMobile ? L["rg.mobile"] : L["common.phone"])" />
                                    </div>
                                    @if (idx > 0)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                            OnClick="@(() => _phoneEntries.RemoveAt(idx))" />
                                    }
                                </div>
                            }
                            @if (_phoneEntries.Count < 4)
                            {
                                @* Adding a number begins with naming WHAT it is. *@
                                <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="mb-2"
                                            StartIcon="@Icons.Material.Filled.AddIcCall">
                                            @L["rg.addPhone"]
                                        </MudButton>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudMenuItem OnClick="@(() => _phoneEntries.Add(new PhoneEntry { IsMobile = true }))">📱 @L["rg.mobile"]</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => _phoneEntries.Add(new PhoneEntry { IsMobile = false }))">☎️ @L["common.phone"]</MudMenuItem>
                                    </ChildContent>
                                </MudMenu>
                            }
                        </MudPaper>

                        @* Where the shop stands is its own subject — a map deserves its own card,
                        not a footnote under the phone numbers. *@
                        <MudPaper Elevation="0" Outlined="true" Class="pa-5 rounded-xl mt-4">
                            <MudText Typo="Typo.h6" Class="mb-1">@L["loc.title"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-4">@L["loc.sub"]</MudText>
                            <LocationPicker @bind-Lat="_lat" @bind-Lng="_lng" />
                        </MudPaper>

                        @* Everything else on the store's card: reachability and registration. *@
                        <MudPaper Elevation="0" Outlined="true" Class="pa-5 rounded-xl mt-4">
                            <MudText Typo="Typo.h6" Class="mb-1">@L["bi.title"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-4">@L["bi.sub"]</MudText>
                            <div class="d-flex" style="gap: 12px;">
                                <MudTextField @bind-Value="_email" Label="@L["bi.email"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 mf-ltr" InputType="InputType.Email"
                                    Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
                                <MudTextField @bind-Value="_whatsapp" Label="@L["bi.whatsapp"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 mf-ltr"
                                    Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Chat" />
                            </div>
                            <div class="d-flex" style="gap: 12px;">
                                <MudTextField @bind-Value="_website" Label="@L["bi.website"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 mf-ltr"
                                    Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Language" />
                                <MudTextField @bind-Value="_instagram" Label="@L["bi.instagram"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 mf-ltr"
                                    Adornment="Adornment.Start" AdornmentText="@("@")" />
                            </div>
                            <MudTextField @bind-Value="_crNumber" Label="@L["bi.cr"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 mf-ltr"
                                HelperText="@L["bi.crHint"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Verified" />
                            @* The REAL VAT registration — printed on every receipt, so it is
                               entered here once and never invented anywhere. *@
                            <MudTextField @bind-Value="_vatNumber" Label="@L["bi.vat"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3 mf-ltr"
                                HelperText="@L["bi.vatHint"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.ReceiptLong" />
                        </MudPaper>

                        @* ---------- The shop's short address ----------
                           orderorange.com/mazagh instead of /restaurant/5000217. Checked
                           live while the owner types, saved on its own button: it has its
                           own uniqueness rule, and holding the whole settings save hostage
                           to a taken handle would be miserable. *@
                        <MudPaper Elevation="0" Outlined="true" Class="pa-5 rounded-xl mt-4">
                            <MudText Typo="Typo.h6" Class="mb-1">@L["slug.title"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-4">@L["slug.sub"]</MudText>
                            <MudTextField T="string" Value="_slug" ValueChanged="OnSlugTyped" Immediate="true"
                                          Label="@L["slug.label"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Class="mf-ltr mf-ascii" MaxLength="40"
                                          Adornment="Adornment.Start" AdornmentText="orderorange.com/" />
                            @if (_slugStatus is not null)
                            {
                                <MudText Typo="Typo.caption"
                                         Color="@(_slugStatus == "free" ? Color.Success : Color.Error)"
                                         Class="d-block mt-1">
                                    @(_slugStatus switch
                                    {
                                        "free" => L["slug.free"],
                                        "taken" => L["slug.taken"],
                                        "reserved" => L["slug.reserved"],
                                        _ => L["slug.invalid"],
                                    })
                                </MudText>
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-3"
                                       Disabled="@(_slugStatus is not null && _slugStatus != "free" && _slug.Length > 0)"
                                       OnClick="SaveSlug">
                                @L["slug.save"]
                            </MudButton>
                            @if (_slugSaved)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success" Class="d-inline-block ms-3">✓ @L["slug.saved"]</MudText>
                            }
                            @* The WHOLE link, ready to hand out — one tap copies it, so
                               nobody retypes their own address from an input's pieces. *@
                            @if (_slug is { Length: > 0 } && (_slugStatus is null or "free"))
                            {
                                <div class="slug-link mf-ltr">
                                    <a href="@FullSlugUrl" target="_blank">@FullSlugUrl</a>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.ContentCopy"
                                               OnClick="CopySlugLink">@L["qr.copyLink"]</MudButton>
                                </div>
                            }
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudPaper Elevation="0" Outlined="true" Class="pa-5 rounded-xl mb-4">
                            <MudText Typo="Typo.h6" Class="mb-4">@L["partner.deliveryTerms"]</MudText>
                            <MudNumericField @bind-Value="_deliveryFee" Label="@L["partner.deliveryFeeOmr"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                Format="0.000" Min="0m" Step="0.100m" Class="mb-3" />
                            <MudNumericField @bind-Value="_minOrder" Label="@L["partner.minOrderOmr"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                Format="0.000" Min="0m" Step="0.500m" Class="mb-3" />
                            <MudNumericField @bind-Value="_prepMinutes" Label="@L["partner.prepTime"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                Min="5" Max="120" Class="mb-3" />
                            <MudNumericField @bind-Value="_taxPercent" Label="@L["partner.taxPercent"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                Min="0m" Max="25m" Step="0.5m" Class="mb-3" Adornment="Adornment.End" AdornmentText="%"
                                HelperText="@L["partner.taxHint"]" />
                            @* Collection costs the shop no delivery at all, so it is on by default;
                            turn it off only if customers genuinely cannot come to the counter. *@
                            <MudSwitch T="bool" @bind-Value="_allowsPickup" Color="Color.Primary"
                                Label="@L["partner.allowPickup"]" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                @L["partner.allowPickupHint"]
                            </MudText>
                            @* Some shops keep their own driver. Their orders then never reach the
                            platform's riders — the shop runs them from its Deliveries page. *@
                            @* Locked ON platform-wide: every store carries its own orders for
                               now, so the switch shows the fact and refuses the finger. *@
                            <MudSwitch T="bool" @bind-Value="_selfDelivery" Color="Color.Primary" Class="mt-2"
                                Label="@L["partner.selfDelivery"]" Disabled="true" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                @L["partner.selfDeliveryHint"]
                            </MudText>
                            @* Which ending the POS save button offers first: park the bill, or settle it. *@
                            <MudSwitch T="bool" @bind-Value="_posDefaultOpen" Color="Color.Primary" Class="mt-2"
                                Label="@L["partner.posDefaultOpen"]" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                @L["partner.posDefaultOpenHint"]
                            </MudText>
                            @* The paper follows the money: settle a bill, get a receipt — no extra tap. *@
                            <MudSwitch T="bool" @bind-Value="_directPrint" Color="Color.Primary" Class="mt-2"
                                Label="@L["partner.directPrint"]" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                @L["partner.directPrintHint"]
                            </MudText>
                            @* Everything the kitchen printer prints — names, edits, headings — in one language. *@
                            <MudSelect T="string" @bind-Value="_kitchenLanguage" Label="@L["partner.kitchenLang"]"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3">
                                <MudSelectItem T="string" Value="@("")">@L["partner.kitchenLangDefault"]</MudSelectItem>
                                @foreach (var (lc, name) in KitchenLanguages)
                                {
                                    <MudSelectItem T="string" Value="@lc">@name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                @L["partner.kitchenLangHint"]
                            </MudText>
                            @* What money is called on every screen and printout of this shop. *@
                            <div class="st-cur mt-3">
                                <MudSelect T="string" Value="_currency" ValueChanged="OnCurrency" Label="@L["partner.currency"]"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="st-cur-pick">
                                    @foreach (var (symbol, name) in Currencies)
                                    {
                                        <MudSelectItem T="string" Value="@symbol">@symbol — @name</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField T="string" @bind-Value="_currency" Label="@L["partner.currencyOwn"]"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="8" Class="st-cur-own" />
                                <span class="st-cur-eg">@L["partner.currencyEg"] <b>@Fmt.Money(12.5m)</b></span>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                @L["partner.currencyHint"]
                            </MudText>
                            @* Photo-less dishes borrow a stock picture guessed from the name; a shop the
                               guesser serves badly turns it off and gets clean emoji tiles. *@
                            <MudSwitch T="bool" @bind-Value="_dishStockPhotos" Color="Color.Primary" Class="mt-2"
                                Label="@L["set.stockPhotos"]" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                @L["set.stockPhotosHint"]
                            </MudText>
                            @* Table bookings from the store's public page — each one waits for this house's yes. *@
                            <MudSwitch T="bool" @bind-Value="_onlineReservations" Color="Color.Primary" Class="mt-2"
                                Label="@L["partner.onlineReservations"]" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                @L["partner.onlineReservationsHint"]
                            </MudText>
                            @* What a booking costs, if anything. Left at zero — the usual
                               case — the guest is never shown a price at all. *@
                            @if (_onlineReservations)
                            {
                                <div class="d-flex gap-3 mt-3">
                                    <MudNumericField T="decimal" @bind-Value="_reservePricePerTable" Min="0" Max="999" Step="0.100m"
                                                     Format="0.000" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                     Label="@L["partner.reservePricePerTable"]" />
                                    <MudNumericField T="decimal" @bind-Value="_reservePricePerMinute" Min="0" Max="99" Step="0.010m"
                                                     Format="0.000" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                     Label="@L["partner.reservePricePerMinute"]" />
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                    @L["partner.reservePriceHint"]
                                </MudText>
                            }
                        </MudPaper>
                        @* The store's own mailbox — contracts and paperwork go out from
                           here, wearing the store's address. Empty = the platform sends. *@
                        <MudPaper Elevation="0" Outlined="true" Class="pa-5 rounded-xl mb-4">
                            <MudText Typo="Typo.h6" Class="mb-1">@L["partner.mailTitle"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                                @L["partner.mailHint"]
                            </MudText>
                            <div class="d-flex gap-3">
                                <MudTextField @bind-Value="_smtpHost" Label="@L["partner.mailHost"]" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Class="mb-3 mf-ltr" MaxLength="200"
                                              Placeholder="smtp.gmail.com" Style="flex: 2;" />
                                <MudNumericField T="int" @bind-Value="_smtpPort" Label="@L["partner.mailPort"]" Min="1" Max="65535"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Style="flex: 1;" />
                            </div>
                            <MudTextField @bind-Value="_smtpUser" Label="@L["partner.mailUser"]" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Class="mb-3 mf-ltr" MaxLength="200" />
                            <MudTextField @bind-Value="_smtpPassword" Label="@L["partner.mailPassword"]" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Class="mb-3 mf-ltr" MaxLength="200"
                                          InputType="InputType.Password" HelperText="@L["partner.mailPasswordHint"]" />
                            <MudTextField @bind-Value="_smtpFrom" Label="@L["partner.mailFrom"]" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Class="mf-ltr" MaxLength="200" />
                        </MudPaper>
                        <MudPaper Elevation="0" Outlined="true" Class="pa-5 rounded-xl mb-4">
                            <MudText Typo="Typo.h6" Class="mb-1">@L["partner.workingHours"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                                @L["partner.hoursHint"]
                            </MudText>
                            @foreach (var day in _hours)
                            {
                                var h = day;
                                <div class="ph-row mb-1">
                                    <span class="d">@DayNames[h.Day]</span>
                                    <MudSwitch T="bool" @bind-Value="h.Closed" Color="Color.Error" Size="Size.Small" />
                                    @if (!h.Closed)
                                    {
                                        <MfTimePicker @bind-Time="h.Open" Variant="Variant.Outlined" Margin="Margin.Dense"
                                            Class="ph-time" Adornment="Adornment.None" TimeFormat="HH:mm" />
                                        <span class="sep">–</span>
                                        <MfTimePicker @bind-Time="h.Close" Variant="Variant.Outlined" Margin="Margin.Dense"
                                            Class="ph-time" Adornment="Adornment.None" TimeFormat="HH:mm" />
                                    }
                                    else
                                    {
                                        <span class="ph-closed">@L["partner.closed"]</span>
                                    }
                                </div>
                            }
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2" OnClick="SaveHours"
                                StartIcon="@Icons.Material.Filled.Schedule" Disabled="_savingHours">@L["partner.saveHours"]</MudButton>
                            </MudPaper>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mt-4"
                                OnClick="Save" Disabled="_saving" StartIcon="@Icons.Material.Filled.Save">
                                @L["common.save"]
                            </MudButton>
                        </MudItem>
                    </MudGrid>

                    @* ---------- Store photo gallery — customers see these as the banner slideshow ---------- *@
                    <MudPaper Elevation="0" Outlined="true" Class="pa-5 rounded-xl mt-4">
                        <div class="d-flex align-center mb-1" style="gap: 8px;">
                            <MudText Typo="Typo.h6">@L["partner.storePhotos"]</MudText>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@(_photos?.Count ?? 0)/4</MudChip>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            @L["partner.storePhotosSub"]
                        </MudText>
                        @if (_photoPct >= 0)
                        {
                            <div class="qc-upload mb-2">
                                <span class="ic"><MudIcon Icon="@Icons.Material.Filled.CloudUpload" Style="width:17px;height:17px;" /></span>
                                <span class="meta">
                                    <small>@L["qc.uploading"]</small>
                                    <span class="bar"><span class="fill" style="width:@(_photoPct)%"></span></span>
                                </span>
                                <b class="pct">@_photoPct%</b>
                            </div>
                        }
                        <div class="pmn-gallery">
                            @foreach (var photo in _photos ?? [])
                            {
                                var ph = photo;
                                <div class="pmn-shot @(ph.IsMain ? "main" : "")">
                                    <img src="@ph.Data" alt="@L["common.storePhoto"]" />
                                    <button type="button" class="x" title="@L["common.delete"]" @onclick="@(() => DeletePhoto(ph))">✕</button>
                                    <label class="pmn-main-ck" title="@L["partner.shownFirst"]">
                                        <input type="checkbox" checked="@ph.IsMain" @onchange="@(() => SetMainPhoto(ph))" />
                                        <span>@L["partner.mainCheck"]</span>
                                    </label>
                                </div>
                            }
                            @if ((_photos?.Count ?? 0) < 4)
                            {
                                <button type="button" class="pmn-shot add" @onclick="AddPhoto" disabled="@_uploadingPhoto">
                                    @if (_uploadingPhoto)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
