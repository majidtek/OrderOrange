        "🥗", "🥬", "🥒", "🍅", "🥕", "🌽", "🥦", "🍆", "🥔", "🧅", "🧄", "🌶️", "🥑", "🫒", "🍄",
        "🍰", "🎂", "🧁", "🍮", "🍩", "🍪", "🍫", "🍬", "🍭", "🍨", "🍦", "🍧", "🍡", "🥮", "🍯",
