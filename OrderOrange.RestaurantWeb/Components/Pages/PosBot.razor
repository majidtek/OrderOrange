    /// <summary>"take me to the reports page" — the page is matched by name in whatever
    /// language the portal is showing, so it works without a hard-coded route list.</summary>
    private void NavigateFlow(string subject)
    {
        (string Label, string Href)[] pages =
        [
            (L["nav.pos"], "/pos"), (L["nav.liveorders"], "/orders"),
            (L["nav.products"], "/menu"), (L["nav.tables"], "/tables"),
            (L["nav.reservations"], "/reservations"), (L["nav.customers"], "/customers"),
            (L["nav.sales"], "/reports"), (L["prep.title"], "/reports/products"),
            (L["crep.title"], "/reports/customers"), (L["mat.title"], "/materials"),
            (L["pur.title"], "/materials/purchases"), (L["nav.allBills"], "/bills"),
            (L["nav.staff"], "/staff"), (L["nav.salaryReport"], "/staff/salary-report"),
            (L["ua.title"], "/team-activity"), (L["nav.teamUsers"], "/team-users"),
            (L["nav.reviews"], "/reviews"), (L["nav.visits"], "/visits"),
            (L["nav.settings"], "/settings"),
        ];

        var hit = pages
            .Select(p => (p, M: Fuzzy.Score(subject, p.Label)))
            .Where(x => x.M.Ok)
            .OrderByDescending(x => x.M.Score)
            .Select(x => x.p)
            .FirstOrDefault();

        if (hit.Href is null) { HelpFlow(); return; }
        Bot(string.Format(TT("pbot.opening"), hit.Label), new Chip($"➡️ {hit.Label}", $"nav:{hit.Href}"));
    }

    /// <summary>The assistant's period words in the shape the report endpoints want.
    /// During a follow-up the period is read from the NEW message, not the repeated one.</summary>
    private string PeriodKey(PosBotNlu.Period period) =>
        (_periodOverride is null ? period : PosBotNlu.DetectPeriod(_periodOverride)) switch
        {
            PosBotNlu.Period.Week => "week",
            PosBotNlu.Period.Month => "month",
            _ => "day",
        };

    // ─────────── matching against the store's own menu (parser: PosBotNlu) ───────────

    private StoreTableDto? ResolveTable(string token)
    {
        var folded = PosBotNlu.Fold(token);
        return _tables.FirstOrDefault(t => PosBotNlu.Fold(t.Name) == folded)
            ?? _tables.FirstOrDefault(t => PosBotNlu.Fold(t.Name).Contains(folded));
    }

    /// <summary>
    /// The store's own menu is the vocabulary: every item is matched by its canonical
    /// name AND all its translations, so "پیتزا", "pizza" or "كباب" all land.
    /// </summary>
    private (MenuItemDto? Best, List<MenuItemDto> Close) MatchItem(string query)
    {
        var qTokens = query.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (qTokens.Length == 0) return (null, []);

        // A dish is named in a few words. A long phrase that reaches here is a
        // sentence, and short tokens inside it ("می", "به") hit dish names by pure
        // chance — offering food for it is how a question became a menu suggestion.
        var meaty = qTokens.Where(t => t.Length >= 3).ToArray();
        if (qTokens.Length > 4 && meaty.Length < 2) return (null, []);

        var scored = new List<(MenuItemDto Item, int Hits, int HayLen)>();
        foreach (var item in _menu!.SelectMany(c => c.Items).Where(i => i.IsAvailable))
        {
            var hay = PosBotNlu.Fold(item.Name + " " + string.Join(' ', item.Names?.Values ?? Enumerable.Empty<string>()));
            var hits = qTokens.Count(t => t.Length >= 3 && hay.Contains(t));
            // A two-letter token only counts when it IS the whole query ("چا", "ti").
            if (hits == 0 && qTokens.Length == 1 && qTokens[0].Length == 2 && hay.Contains(qTokens[0])) hits = 1;
            if (hits > 0) scored.Add((item, hits, hay.Length));
        }
        if (scored.Count == 0) return (null, []);

        var full = scored.Where(s => s.Hits == qTokens.Length)
                         .OrderBy(s => s.HayLen)
                         .Select(s => s.Item)
                         .ToList();
        if (full.Count == 1) return (full[0], []);
        if (full.Count > 1)
        {
            // Several items genuinely contain every word ("کباب") — the shortest name is
            // the plain one, but offer the neighbours when they are truly different dishes.
            var head = full[0];
            var rivals = full.Skip(1).Take(3).ToList();
            return rivals.Count > 0 && PosBotNlu.Fold(head.Name).Length + 6 < PosBotNlu.Fold(rivals[0].Name).Length
                ? (head, [])
                : (null, full.Take(4).ToList());
        }
        // Partial hits are only a suggestion when most of the query actually matched —
        // one word out of five is noise, not a near-miss.
        var best = scored.OrderByDescending(s => s.Hits).ThenBy(s => s.HayLen).ToList();
        if (best[0].Hits * 2 < qTokens.Length) return (null, []);
        return (null, best.Take(3).Select(s => s.Item).ToList());
    }
}
