    }

    /// <summary>
    /// "and yesterday?" — the previous question again, over a different stretch of time.
    /// Without the memory of what was just asked this is meaningless, so a follow-up with
    /// nothing behind it says so rather than guessing.
    /// </summary>
    private async Task RepeatAsync(string raw)
    {
        if (_lastAsk is null && _lastPeriodIntent is null) { HelpFlow(); return; }

        // The period comes from the NEW message; everything else from the old one.
        _periodOverride = raw;
        try
        {
            if (_lastAsk is { } ask) { await AnswerAsync(new PosBotNlu.Asked(ask, _lastSubject), raw); return; }
            switch (_lastPeriodIntent)
            {
                case PosBotNlu.Intent.Revenue: await RevenueFlowAsync(raw); return;
                case PosBotNlu.Intent.TopItems: await TopItemsFlowAsync(); return;
                default: HelpFlow(); return;
            }
        }
        finally { _periodOverride = null; }
    }

    /// <summary>"show me more" — the last answer again, with the list caps lifted.</summary>
    private async Task MoreAsync()
    {
        if (_lastAsk is null) { HelpFlow(); return; }
        _showAll = true;
        await AnswerAsync(new PosBotNlu.Asked(_lastAsk.Value, _lastSubject), _lastRaw ?? "");
    }

    /// <summary>The shelf, one ingredient at a time. The name is matched the same loose
    /// way dishes are, because nobody types "Basmati Rice 5kg" when they mean rice.</summary>
    private async Task StockLevelAsync(string subject)
    {
        var stock = await Api.GetMaterialsAsync();
        if (stock is null || stock.Items.Count == 0) { Bot(TT("pbot.noStock")); return; }

        var needle = PosBotNlu.Fold(subject);
        var hits = stock.Items
            .Select(m => (M: m, Hay: PosBotNlu.Fold(m.Name)))
            .Where(x => x.Hay.Contains(needle) || needle.Contains(x.Hay))
            .OrderBy(x => x.Hay.Length)
            .Select(x => x.M)
            .ToList();

        if (hits.Count == 0)
        {
            Bot(string.Format(TT("pbot.noMaterial"), subject),
                new Chip($"📦 {L["mat.title"]}", "nav:/materials"));
            return;
        }

        _messages.Add(new Msg
        {
            FromBot = true,
            Text = string.Format(TT("pbot.stockOf"), hits[0].Name),
            Rows = hits.Take(_showAll ? 20 : 6).Select(m => new Row(
                m.IsOut ? "🚫" : m.IsLow ? "⚠️" : "📦",
                m.Name,
                $"{m.Quantity:0.##} {m.Unit}" + (m.MinQuantity > 0 ? $" · {TT("pbot.min")} {m.MinQuantity:0.##}" : ""),
                m.IsOut ? TT("pbot.outOf") : m.IsLow ? TT("pbot.lowStock") : "")).ToList(),
            Chips = [new Chip($"📦 {L["mat.title"]}", "nav:/materials")],
        });
    }

    /// <summary>Everything at or under its reorder level — the shopping list.</summary>
    private async Task StockLowAsync()
    {
        var stock = await Api.GetMaterialsAsync();
        if (stock is null || stock.Items.Count == 0) { Bot(TT("pbot.noStock")); return; }

        var short_ = stock.Items.Where(m => m.IsOut || m.IsLow)
            .OrderBy(m => m.IsOut ? 0 : 1).ThenBy(m => m.Quantity).ToList();

        if (short_.Count == 0)
        {
            Bot(TT("pbot.stockFine"), new Chip($"📦 {L["mat.title"]}", "nav:/materials"));
            return;
        }

        _messages.Add(new Msg
        {
            FromBot = true,
            Text = string.Format(TT("pbot.runningOut"), stock.OutCount, stock.LowCount),
            Rows = short_.Take(_showAll ? 40 : 8).Select(m => new Row(
                m.IsOut ? "🚫" : "⚠️", m.Name, $"{m.Quantity:0.##} {m.Unit}",
                m.IsOut ? TT("pbot.outOf") : TT("pbot.lowStock"))).ToList(),
            Chips =
            [
                new Chip($"🛒 {L["pur.title"]}", "nav:/materials/purchases"),
                new Chip($"📦 {L["mat.title"]}", "nav:/materials"),
            ],
        });
    }

