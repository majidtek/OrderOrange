    /// <summary>"Which tables are reserved?" — today's bookings, from the real book.</summary>
    private async Task ReservedFlowAsync()
    {
        var reservations = (await Api.GetReservationsAsync() ?? [])
            .Where(r => r.Status is not ("cancelled" or "rejected"))
            .OrderBy(r => r.At)
            .Take(6)
            .ToList();
        if (reservations.Count == 0)
        {
            // An empty book isn't a dead end — the busy tables are the next-best answer.
            var busyNow = _tables.Where(t => t.IsOccupied).Take(6).ToArray();
            Bot(TT("pbot.noReservations") + (busyNow.Length > 0 ? "\n" + string.Format(TT("pbot.busyTitle"), busyNow.Length) : ""),
                busyNow.Select(t => new Chip($"💵 {t.Name}", $"closetbl:{t.Id}"))
                    .Append(new Chip($"📅 {L["nav.reservations"]}", "nav:/reservations"))
                    .ToArray());
            return;
        }
        _messages.Add(new Msg
        {
            FromBot = true,
            Text = string.Format(TT("pbot.resTitle"), reservations.Count),
            Rows = reservations.Select(r => new Row(
                $"🍽️ {r.TableName}",
                r.Name,
                $"👥 {r.Guests}" + (r.Status == "confirmed" ? " · ✓" : ""),
                r.At.Date == DateTime.Today ? r.At.ToString("HH:mm") : r.At.ToString("ddd HH:mm"))).ToList(),
            Chips = [new Chip($"📅 {L["nav.reservations"]}", "nav:/reservations")],
        });
