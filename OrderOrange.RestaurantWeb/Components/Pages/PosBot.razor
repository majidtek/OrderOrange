@using OrderOrange.RestaurantWeb.Services
@inject ApiClient Api
@inject OrderOrange.RestaurantWeb.Services.ReceiptPrinter Printer
@inject LanguageService L
@inject NavigationManager Nav
@inject IJSRuntime JS

@* The partner's order assistant: the owner types "2 pizza table 2" (in any of the
   app's languages, any digit script) and the bot rings it onto that table's real
   invoice — the same OpenTab/AddTabLines calls the POS itself makes. *@

@* There is no floating button any more. The assistant is opened from the spark in the
   app bar, which is always in the same place, never lands on top of the sidebar, and
   cannot drift off the edge of the screen the way a corner-anchored FAB did. *@

@if (_open)
{
    <div class="pb-veil" @onclick="@(() => _open = false)"></div>
    <div class="pb-panel">
        <div class="pb-head">
            <span class="pb-ava">🤖</span>
            <div class="pb-head-tx">
                <b>@L["pbot.name"]</b>
                <small>@L["pbot.sub"]</small>
            </div>
            <button type="button" class="pb-x" @onclick="@(() => _open = false)">✕</button>
        </div>

        <div class="pb-body" id="pb-scroll">
            @foreach (var m in _messages)
            {
                <div class="pb-msg @(m.FromBot ? "bot" : "me")">
                    @if (m.FromBot)
                    {
                        <span class="pb-mini">🤖</span>
                    }
                    <div class="pb-stack">
                    @if (m.Text is not null)
                    {
                        <div class="pb-bubble">@m.Text</div>
                    }
                    @if (m.Card is { } card)
                    {
                        <div class="pb-card">
                            <div class="pb-card-title">🧾 @L["pbot.confirmTitle"]</div>
                            @foreach (var line in card.Lines)
                            {
                                <div class="pb-line">
                                    <span class="q">@line.Qty</span>
                                    <span class="n">@line.Name</span>
                                    <b class="p mf-ltr">@Fmt.Rial(line.Total)</b>
                                </div>
                            }
                            <div class="pb-card-foot">
                                <span class="pb-tbl">🍽️ @L["pbot.table"] @card.TableName</span>
                                <b class="mf-ltr">@Fmt.Rial(card.Total)</b>
                            </div>
                        </div>
                    }
                    @if (m.Rows.Count > 0)
                    {
                        <div class="pb-rows">
                            @foreach (var row in m.Rows)
                            {
                                <div class="pb-row">
                                    <span class="tbl">@row.Pill</span>
                                    <div class="mid">
                                        <b>@row.Title</b>
                                        <small>@row.Meta</small>
                                    </div>
                                    <span class="badge mf-ltr">@row.Badge</span>
                                </div>
                            }
                        </div>
                    }
                    @if (m.Chips.Count > 0)
                    {
                        <div class="pb-chips">
                            @foreach (var chip in m.Chips)
                            {
                                var c = chip;
                                <button type="button" class="pb-chip @(c.Payload == "confirm" ? "main" : "")"
                                        @onclick="@(() => OnChipAsync(c.Payload, c.Label))">@c.Label</button>
                            }
                        </div>
                    }
                    </div>
                </div>
            }
            @if (_busy)
            {
                <div class="pb-msg bot"><div class="pb-bubble pb-typing"><i></i><i></i><i></i></div></div>
            }
        </div>

        <div class="pb-input">
            <input type="text" placeholder="@L["pbot.placeholder"]" @bind="_input" @bind:event="oninput"
                   @onkeydown="OnKeyAsync" />
            <button type="button" class="pb-send" disabled="@(_busy || string.IsNullOrWhiteSpace(_input))"
                    @onclick="SendAsync">➤</button>
        </div>
    </div>
}

@code {
    private sealed record Chip(string Label, string Payload);
    private sealed record CardLine(int Qty, string Name, decimal Total);
    private sealed record Card(List<CardLine> Lines, string TableName, decimal Total);

    /// <summary>One structured row in a list answer (a reservation, a menu section…).</summary>
    private sealed record Row(string Pill, string Title, string Meta, string Badge);

    private sealed class Msg
    {
        public bool FromBot;
        public string? Text;
        public List<Chip> Chips = [];
        public Card? Card;
        public List<Row> Rows = [];
    }

    private readonly List<Msg> _messages = [];
    private bool _open;
    private bool _busy;
    private string _input = "";

    private List<MenuCategoryDto>? _menu;
    private List<StoreTableDto> _tables = [];

    // the order being assembled
    private readonly List<(MenuItemDto Item, int Qty)> _draft = [];
    private StoreTableDto? _draftTable;

    /// <summary>
    /// The language the OWNER is typing in, which is not always the language the portal
    /// is set to. A shop may run its interface in Farsi while the evening manager types
    /// Arabic; answering that person in Farsi is the assistant ignoring them.
    ///
    /// It is sticky on purpose. Once someone has written a full sentence in Arabic, their
    /// next message might be a bare "5" or a dish name with no language signal at all —
    /// the conversation should stay in Arabic rather than snapping back mid-exchange.
    /// </summary>
    private string? _replyLocale;

    /// <summary>Bot copy, in the language of the conversation rather than of the chrome.</summary>
    private string TT(string key) => LanguageService.Translate(_replyLocale ?? L.Locale, key);

    // ── what was just asked, so "and yesterday?" and "show me more" mean something ──

    private PosBotNlu.Ask? _lastAsk;
    private string? _lastSubject;
    private string? _lastRaw;

    /// <summary>Set when the last answer was one of the order parser's period questions
    /// (revenue, best sellers) rather than one of the business questions.</summary>
    private PosBotNlu.Intent? _lastPeriodIntent;

    /// <summary>During a follow-up, the sentence the PERIOD should be read from — the new
    /// message — while the question itself comes from the old one.</summary>
    private string? _periodOverride;

    /// <summary>Opened from the app bar as well as from its own floating button, so the
    /// assistant is one click away on every page rather than only the dashboard.
    ///
    /// The explicit re-render matters: when the FAB is pressed Blazor re-renders this
    /// component as part of dispatching the event, but a call arriving from the layout
    /// mutates state behind the renderer's back and would leave the panel closed.</summary>
    public async Task OpenAsync()
    {
        await OpenBot();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenBot()
    {
        _open = true;
        if (_menu is null)
        {
            _menu = await Api.GetMyMenuBasicAsync() ?? [];
            _tables = await Api.GetTablesAsync() ?? [];
        }
        if (_messages.Count == 0)
        {
            var hello = new Msg { FromBot = true, Text = TT("pbot.hi") };
            // Example chips built from the store's own menu — tappable, real.
            var sample = _menu.SelectMany(c => c.Items).FirstOrDefault();
            var table = _tables.FirstOrDefault(t => !t.IsOccupied) ?? _tables.FirstOrDefault();
            if (sample is not null && table is not null)
                hello.Chips.Add(new Chip($"2 {sample.NameFor(L.Locale)} — {TT("pbot.table")} {table.Name}",
                    $"ex:2 {sample.NameFor(L.Locale)} {TT("pbot.table")} {table.Name}"));
            var second = _menu.SelectMany(c => c.Items).Skip(6).FirstOrDefault();
            if (second is not null)
                hello.Chips.Add(new Chip($"1 {second.NameFor(L.Locale)}", $"ex:1 {second.NameFor(L.Locale)}"));
            _messages.Add(hello);
        }
    }

    private void Bot(string text, params Chip[] chips) =>
        _messages.Add(new Msg { FromBot = true, Text = text, Chips = [.. chips] });

    /// <summary>New message → the conversation keeps its newest line in view.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("mfPos.scrollBottom", "#pb-scroll"); } catch { }
        if (_open)
        {
            // The phone keyboard hides the bottom of the screen — lift the panel above it.
            try { await JS.InvokeVoidAsync("mfPos.keyboardAware", ".pb-panel"); } catch { }
            try { await JS.InvokeVoidAsync("mfPos.draggable", ".pb-panel", ".pb-head", "oo-pbot-pos"); } catch { }
        }
    }

    private async Task OnChipAsync(string payload, string label)
    {
        var parts = payload.Split(':', 2);
        switch (parts[0])
        {
            case "ex": _input = parts[1]; await SendAsync(); break;
            case "tbl":
                _draftTable = _tables.FirstOrDefault(t => t.Id == int.Parse(parts[1]));
                _messages.Add(new Msg { FromBot = false, Text = label });
                ShowDraft();
                break;
            case "add":
            {
                var item = _menu!.SelectMany(c => c.Items).FirstOrDefault(i => i.Id == int.Parse(parts[1]));
                if (item is not null)
                {
                    _messages.Add(new Msg { FromBot = false, Text = item.NameFor(L.Locale) });
                    _draft.Add((item, _pendingQty ?? 1));
                    _pendingQty = null;
                    ShowDraft();
                }
                break;
            }
            case "confirm": await PlaceAsync(); break;
            case "cancel":
                _draft.Clear(); _draftTable = null;
                Bot(TT("pbot.cancelled"));
                break;
            case "opentbl":
            {
                _messages.Add(new Msg { FromBot = false, Text = label });
                var table = _tables.FirstOrDefault(t => t.Id == int.Parse(parts[1]));
                if (table is not null) await OpenTableAsync(table);
                break;
            }
            case "billtbl":
            {
                _messages.Add(new Msg { FromBot = false, Text = label });
                await ShowTableBillAsync(int.Parse(parts[1]));
                break;
            }
            case "closetbl":
            {
                _messages.Add(new Msg { FromBot = false, Text = label });
                var bits = parts[1].Split(':');
                PosBotNlu.PayKind? pay = bits.Length > 1
                    ? bits[1] == "card" ? PosBotNlu.PayKind.Card : PosBotNlu.PayKind.Cash
                    : null;
                await CloseTableAsync(int.Parse(bits[0]), pay);
                break;
            }
            case "booktbl":
            {
                _messages.Add(new Msg { FromBot = false, Text = label });
                var table = _tables.FirstOrDefault(t => t.Id == int.Parse(parts[1]));
                if (table is not null && _booking is { } b)
                {
                    _booking = (table.Id, table.Name, b.At, b.Guests);
                    ContinueBooking();
                }
                break;
            }
            case "booktime":
            {
                _messages.Add(new Msg { FromBot = false, Text = label });
                if (_booking is { } b)
                {
                    var at = DateTime.Today.AddHours(int.Parse(parts[1]));
                    if (at <= DateTime.Now) at = at.AddDays(1);
                    _booking = (b.TableId, b.TableName, at, b.Guests);
                    ContinueBooking();
                }
                break;
            }
            case "bookgo":
                _messages.Add(new Msg { FromBot = false, Text = label });
                await ConfirmBookingAsync();
                break;
            case "bookno":
                _booking = null;
                Bot(TT("pbot.cancelled"));
                break;
            case "nav": Nav.NavigateTo(parts[1]); break;
            // Flipping the open sign from the chip the status answer offered.
            case "shop": await ShopToggleAsync(parts[1] == "open"); break;
        }
    }

    /// <summary>Enter sends. Awaited properly — a discarded task never re-renders.</summary>
    private async Task OnKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendAsync();
    }

    private async Task SendAsync()
    {
        var text = _input.Trim();
        if (text.Length == 0 || _busy) return;
        _input = "";
        var mark = _messages.Count;          // everything added past here is the answer
        _messages.Add(new Msg { FromBot = false, Text = text });
        _busy = true;
        StateHasChanged();
        try { await UnderstandAsync(text); }
        catch { Bot(L["common.wentWrong"]); }
        finally
        {
            _busy = false;
            StateHasChanged();
            LogTurn(text, mark);
        }
    }

    /// <summary>One id per sitting, so the report shows conversations rather than loose lines.</summary>
    private readonly string _session = Guid.NewGuid().ToString("N");

    /// <summary>
    /// Files the exchange for the assistant report. Fire-and-forget: the till must never
    /// wait on bookkeeping, and a failed log must never look like a broken assistant.
    /// </summary>
    private void LogTurn(string text, int mark)
    {
        var reply = string.Join(" ", _messages.Skip(mark + 1)
            .Where(m => m.FromBot && !string.IsNullOrWhiteSpace(m.Text))
            .Select(m => m.Text));
        _ = Task.Run(async () =>
        {
            try
            {
                await Api.LogBotChatAsync(new BotChatLogRequest(
                    _session, "pos", text, reply, "/pos", L.Locale));
            }
            catch { }
        });
    }

    // ────────────────────────── understanding ──────────────────────────

    private int? _pendingQty;

    /// <summary>"کل میزها" asked for everything — list answers stop truncating.</summary>
    private bool _showAll;

    private async Task UnderstandAsync(string raw)
    {
        await Task.Delay(250);   // a beat of "thinking" reads better than instant

        // Answer in the language they wrote in. Null means the message carried no signal
        // (a bare number, an emoji), and the conversation keeps whatever it was already in.
        if (PosBotNlu.DetectLocale(raw, L.Locale) is { } spoken) _replyLocale = spoken;

        // "switch to Arabic" — before every other reading, because a language name is a
        // short word that a fuzzy dish matcher would happily mistake for food.
        if (LanguagePick.Resolve(raw) is { } wanted) { await SwitchLanguageAsync(wanted); return; }

        // Arithmetic and the clock come before everything else, and both are strict about
        // claiming a sentence: a sum must be arithmetic from end to end, and a clock
        // question needs an actual date or time noun. Neither can swallow an order.
        if (PosBotNlu.TryCalculate(raw) is { Ok: true } sum) { ShowSum(sum); return; }
        if (PosBotNlu.DetectClock(raw) is var clock && clock != PosBotNlu.Clock.None)
        {
            ShowClock(clock);
            return;
        }

        _showAll = PosBotNlu.WantsAll(raw);

        // A word aimed at a pending booking is an answer, not a new request.
        if (_booking is not null)
        {
            if (PosBotNlu.IsConfirm(raw)) { await ConfirmBookingAsync(); return; }
            if (PosBotNlu.IsCancel(raw)) { _booking = null; Bot(TT("pbot.cancelled")); return; }
        }

        // A word aimed at the pending card is an answer, not a new order.
        if (_draft.Count > 0)
        {
            if (PosBotNlu.IsConfirm(raw)) { await PlaceAsync(); return; }
            if (PosBotNlu.IsCancel(raw))
            {
                _draft.Clear();
                _draftTable = null;
                Bot(TT("pbot.cancelled"));
                return;
            }
            // "نوشابه رو حذف کن" — surgery on the pending order, not a new one.
            if (PosBotNlu.WantsRemove(raw)) { RemoveFromDraft(raw); return; }
        }

        // Beyond ordering: the assistant runs the floor and answers its questions.
        // Questions about the BUSINESS — stock, staff, salaries, money owed, reputation,
        // traffic, the open sign. This pass declines everything the order parser owns, so
        // it is safe to run first and cheap when it finds nothing.
        var asked = PosBotNlu.DetectAsk(raw);
        if (asked.Kind != PosBotNlu.Ask.None)
        {
            // Remember it, so the next "and yesterday?" has something to repeat. The two
            // follow-up kinds are excluded on purpose — they are not questions of their
            // own, and remembering one would make the memory point at itself.
            if (asked.Kind is not (PosBotNlu.Ask.SamePeriodAgain or PosBotNlu.Ask.MoreOfTheSame))
            {
                _lastAsk = asked.Kind;
                _lastSubject = asked.Subject;
                _lastRaw = raw;
                _lastPeriodIntent = null;
            }
            await AnswerAsync(asked, raw);
            return;
        }

        switch (PosBotNlu.DetectIntent(raw))
        {
            case PosBotNlu.Intent.OpenTable: await OpenTableFlowAsync(raw); return;
            case PosBotNlu.Intent.CloseTable: await CloseTableFlowAsync(raw); return;
            case PosBotNlu.Intent.Tables: TablesFlow(); return;
            case PosBotNlu.Intent.Reserved: await ReservedFlowAsync(); return;
            case PosBotNlu.Intent.FreeTables: FreeTablesFlow(); return;
            case PosBotNlu.Intent.BusyTables: BusyTablesFlow(); return;
            case PosBotNlu.Intent.Revenue: _lastAsk = null; _lastPeriodIntent = PosBotNlu.Intent.Revenue; await RevenueFlowAsync(raw); return;
            case PosBotNlu.Intent.LiveOrders: await LiveOrdersFlowAsync(); return;
            case PosBotNlu.Intent.TableBill: await TableBillFlowAsync(raw); return;
            case PosBotNlu.Intent.Help: HelpFlow(); return;
            case PosBotNlu.Intent.Greeting: Bot(TT("pbot.hi")); HelpFlow(); return;
            case PosBotNlu.Intent.Thanks: Bot(TT("pbot.yw")); return;
            case PosBotNlu.Intent.Menu: MenuFlow(); return;
            case PosBotNlu.Intent.MakeReservation: BookingFlow(raw); return;
            case PosBotNlu.Intent.TopItems: _lastAsk = null; _lastPeriodIntent = PosBotNlu.Intent.TopItems; await TopItemsFlowAsync(); return;
        }

        var command = PosBotNlu.Parse(raw);
        if (command.Table is not null)
        {
            _draftTable = ResolveTable(command.Table);
            if (_draftTable is null)
            {
                Bot(string.Format(TT("pbot.noSuchTable"), command.Table), FreeTableChips());
                return;
            }
        }

        if (command.Items.Count == 0 && _draftTable is not null) { ShowDraft(); return; }
        if (command.Items.Count == 0) { Bot(TT("pbot.hi")); return; }

        // "قهوه داریم؟" asks about AVAILABILITY — answer with the item, don't order it.
        if (PosBotNlu.LooksLikeQuestion(raw) && command.Table is null && command.Items.Count == 1)
        {
            var (hit, _) = MatchItem(command.Items[0].Query);
            if (hit is not null)
            {
                Bot(string.Format(TT("pbot.haveIt"), hit.NameFor(L.Locale), Fmt.Money(hit.FinalPrice)),
                    new Chip($"➕ {hit.NameFor(L.Locale)}", $"add:{hit.Id}"),
                    new Chip($"📋 {L["nav.products"]}", "nav:/products"));
                return;
            }
        }

        // "یه نوشابه هم اضافه کن" grows the pending order; anything else replaces it.
        if (!(_draft.Count > 0 && PosBotNlu.WantsAppend(raw)))
            _draft.Clear();
        foreach (var want in command.Items)
        {
            var (best, close) = MatchItem(want.Query);
            if (best is not null)
            {
                _draft.Add((best, want.Qty));
            }
            else if (close.Count > 0 && !PosBotNlu.LooksLikeQuestion(raw))
            {
                // "Did you mean…" only makes sense for something that WAS an order.
                _pendingQty = want.Qty;
                Bot(string.Format(TT("pbot.didYouMean"), want.Query),
                    close.Take(3).Select(i => new Chip(i.NameFor(L.Locale), $"add:{i.Id}")).ToArray());
                return;
            }
            else
            {
                // A question that reached the menu matcher was never an order —
                // answer with what the assistant CAN do instead of "not on the menu".
                if (PosBotNlu.LooksLikeQuestion(raw)) { HelpFlow(); return; }
                Bot(string.Format(TT("pbot.notFound"), want.Query));
                return;
            }
        }
        ShowDraft();
    }

    private void ShowDraft()
    {
        if (_draft.Count == 0) { Bot(TT("pbot.hi")); return; }
        if (_draftTable is null)
        {
            Bot(TT("pbot.whichTable"), FreeTableChips());
            return;
        }

        var lines = _draft.Select(d => new CardLine(d.Qty, d.Item.NameFor(L.Locale), d.Item.FinalPrice * d.Qty)).ToList();
        _messages.Add(new Msg
        {
            FromBot = true,
            Card = new Card(lines, _draftTable.Name, lines.Sum(l => l.Total)),
            Chips =
            [
                new Chip($"✅ {TT("pbot.confirm")}", "confirm"),
                new Chip($"✕ {L["common.cancel"]}", "cancel"),
            ],
        });
    }

    private Chip[] FreeTableChips() =>
        _tables.Where(t => !t.IsOccupied).Take(6)
            .Concat(_tables.Where(t => t.IsOccupied).Take(2))
            .Take(6)
            .Select(t => new Chip($"🍽️ {t.Name}", $"tbl:{t.Id}"))
            .ToArray();

    private async Task PlaceAsync()
    {
        if (_draft.Count == 0 || _draftTable is null) return;
        _busy = true;
        StateHasChanged();
        try
        {
            // Exactly the till's own path: the table's running invoice, or a fresh walk-in.
            var tab = await Api.GetTabForTableAsync(_draftTable.Id);
            if (tab is null)
            {
                var (opened, error) = await Api.OpenTabAsync(new OpenTabRequest(_draftTable.Id, null, L["pos.walkin"]));
                if (opened is null) { Bot(error ?? L["common.saveFail"]); return; }
                tab = opened;
            }
            var items = _draft.Select(d => new PlaceOrderItem(d.Item.Id, d.Qty, null)).ToList();
            var (updated, addError) = await Api.AddTabLinesAsync(tab.Id, new AddTabLinesRequest(items));
            if (updated is null) { Bot(addError ?? L["common.saveFail"]); return; }

            var tableName = _draftTable.Name;
            var posUrl = $"/pos/{_draftTable.Id}";
            _draft.Clear();
            _draftTable = null;
            _tables = await Api.GetTablesAsync() ?? _tables;

            Bot(string.Format(TT("pbot.done"), tableName, updated.Id),
                new Chip($"🧾 {TT("pbot.openPos")}", $"nav:{posUrl}"),
                new Chip($"➕ {TT("pbot.another")}", "cancel"));
        }
        finally
        {
            _busy = false;
        }
    }

    // ───────────────────── open / close / floor status ─────────────────────

    private async Task OpenTableFlowAsync(string raw)
    {
        var (token, _) = PosBotNlu.ExtractTable(raw);
        var table = token is null ? null : ResolveTable(token);
        if (table is null)
        {
            Bot(TT("pbot.whichOpen"), _tables.Where(t => !t.IsOccupied).Take(6)
                .Select(t => new Chip($"🍽️ {t.Name}", $"opentbl:{t.Id}")).ToArray());
            return;
        }
        await OpenTableAsync(table);
    }

    private async Task OpenTableAsync(StoreTableDto table)
    {
        var existing = await Api.GetTabForTableAsync(table.Id);
        if (existing is not null)
        {
            Bot(string.Format(TT("pbot.alreadyOpen"), table.Name, existing.Id),
                new Chip($"🧾 {TT("pbot.openPos")}", $"nav:/pos/{table.Id}"),
                new Chip($"💵 {TT("pbot.closeIt")}", $"closetbl:{table.Id}"));
            return;
        }
        var (opened, error) = await Api.OpenTabAsync(new OpenTabRequest(table.Id, null, L["pos.walkin"]));
        if (opened is null) { Bot(error ?? L["common.saveFail"]); return; }
        _tables = await Api.GetTablesAsync() ?? _tables;
        Bot(string.Format(TT("pbot.opened"), table.Name, opened.Id),
            new Chip($"🧾 {TT("pbot.openPos")}", $"nav:/pos/{table.Id}"),
            new Chip($"➕ {TT("pbot.another")}", "cancel"));
    }

    private async Task CloseTableFlowAsync(string raw)
    {
        var (token, _) = PosBotNlu.ExtractTable(raw);
        var pay = PosBotNlu.DetectPay(raw);
        var table = token is null ? null : ResolveTable(token);
        if (table is null)
        {
            var busy = _tables.Where(t => t.IsOccupied).Take(6).ToArray();
            if (busy.Length == 0) { Bot(TT("pbot.nothingOpen")); return; }
            Bot(TT("pbot.whichClose"), busy
                .Select(t => new Chip($"🍽️ {t.Name}", $"closetbl:{t.Id}{(pay is null ? "" : pay == PosBotNlu.PayKind.Cash ? ":cash" : ":card")}"))
                .ToArray());
            return;
        }
        await CloseTableAsync(table.Id, pay);
    }

    private async Task CloseTableAsync(int tableId, PosBotNlu.PayKind? pay)
    {
        var table = _tables.FirstOrDefault(t => t.Id == tableId);
        if (table is null) return;
        var tab = await Api.GetTabForTableAsync(tableId);
        if (tab is null)
        {
            Bot(string.Format(TT("pbot.notOpen"), table.Name));
            return;
        }
        if (pay is null)
        {
            // The money question deserves an explicit answer, not a default.
            Bot(string.Format(TT("pbot.howPay"), table.Name),
                new Chip($"💵 {TT("pbot.cash")}", $"closetbl:{tableId}:cash"),
                new Chip($"💳 {TT("pbot.card")}", $"closetbl:{tableId}:card"));
            return;
        }

        var method = pay == PosBotNlu.PayKind.Card ? PaymentMethod.CardOnDelivery : PaymentMethod.CashOnDelivery;
        var (order, error) = await Api.CloseTabAsync(tab.Id, new CloseTabRequest(method, MarkPaid: true));
        if (order is null) { Bot(error ?? L["common.saveFail"]); return; }
        await Printer.PrintAsync(order);
        _tables = await Api.GetTablesAsync() ?? _tables;
        Bot(string.Format(TT("pbot.closed"), table.Name, order.Number, Fmt.Money(order.Total)),
            new Chip($"➕ {TT("pbot.another")}", "cancel"));
    }

