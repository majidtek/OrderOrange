    /// <summary>"How were sales today / yesterday / this week?" — same history Reports uses.</summary>
    private async Task RevenueFlowAsync(string raw)
    {
        var period = PosBotNlu.DetectPeriod(raw);
        var history = await Api.GetRestaurantHistoryAsync(0, 500) ?? [];
        var (from, to, labelKey) = period switch
        {
            PosBotNlu.Period.Yesterday => (DateTime.Today.AddDays(-1), DateTime.Today, "pbot.yesterday"),
            PosBotNlu.Period.Week => (DateTime.Today.AddDays(-6), DateTime.Today.AddDays(1), "pbot.thisweek"),
            PosBotNlu.Period.Month => (DateTime.Today.AddDays(-29), DateTime.Today.AddDays(1), "pbot.thismonth"),
            _ => (DateTime.Today, DateTime.Today.AddDays(1), "pbot.today"),
        };
        var slice = history.Where(o => o.PlacedAt >= from && o.PlacedAt < to && o.Status == OrderStatus.Delivered).ToList();
        Bot($"{L[labelKey]} — " + string.Format(TT("pbot.revenue"), slice.Count, Fmt.Money(slice.Sum(o => o.Total))),
            new Chip($"📊 {L["nav.reports"]}", "nav:/reports"));
    }

    /// <summary>"پرفروش‌ترین غذا؟" — the last 30 days' leaderboard as medal rows.</summary>
    private async Task TopItemsFlowAsync()
    {
        var history = await Api.GetRestaurantHistoryAsync(0, 500) ?? [];
        var top = history
            .Where(o => o.Status == OrderStatus.Delivered && o.PlacedAt >= DateTime.Today.AddDays(-29))
            .SelectMany(o => o.Items)
            .GroupBy(i => i.Name)
            .Select(g => (Name: g.Key, Qty: g.Sum(i => i.Quantity), Money: g.Sum(i => i.UnitPrice * i.Quantity)))
            .OrderByDescending(x => x.Qty)
            .Take(5)
            .ToList();
        if (top.Count == 0) { Bot(TT("pbot.noData")); return; }
        var medals = new[] { "🥇", "🥈", "🥉", "4", "5" };
        _messages.Add(new Msg
        {
            FromBot = true,
            Text = TT("pbot.topTitle"),
            Rows = top.Select((x, i) => new Row(medals[i], x.Name, $"×{x.Qty}", Fmt.Money(x.Money))).ToList(),
            Chips = [new Chip($"📊 {L["nav.reports"]}", "nav:/reports")],
        });
    }

    // ────────────────────────── booking a table ──────────────────────────

    private (int TableId, string TableName, DateTime? At, int Guests)? _booking;

    /// <summary>"میز ۶ رو برای ساعت ۸ رزرو کن ۴ نفر" — book it, asking only for what's missing.</summary>
    private void BookingFlow(string raw)
    {
        var (token, _) = PosBotNlu.ExtractTable(raw);
        var table = token is null ? null : ResolveTable(token);
        var guests = PosBotNlu.ExtractGuests(raw) ?? 2;
        DateTime? at = null;
        if (PosBotNlu.ExtractTime(raw) is (int h, int m))
        {
            at = DateTime.Today.AddHours(h).AddMinutes(m);
            if (at <= DateTime.Now) at = at.Value.AddDays(1);   // that time already passed → tomorrow
        }
        if (table is null)
        {
            _booking = (0, "", at, guests);
            Bot(TT("pbot.bookWhichTable"), _tables.Take(8).Select(t => new Chip($"🍽️ {t.Name}", $"booktbl:{t.Id}")).ToArray());
            return;
        }
        _booking = (table.Id, table.Name, at, guests);
        ContinueBooking();
    }

    private void ContinueBooking()
    {
        if (_booking is not { } b) return;
        if (b.At is null)
        {
            Bot(TT("pbot.bookWhen"),
                new[] { 18, 19, 20, 21 }.Select(h => new Chip($"🕗 {h}:00", $"booktime:{h}")).ToArray());
            return;
        }
        Bot(string.Format(TT("pbot.bookConfirm"), b.TableName, b.At.Value.ToString(b.At.Value.Date == DateTime.Today ? "HH:mm" : "ddd HH:mm"), b.Guests),
            new Chip($"✅ {TT("pbot.bookIt")}", "bookgo"),
            new Chip($"❌ {L["common.cancel"]}", "bookno"));
    }

    private async Task ConfirmBookingAsync()
    {
        if (_booking is not { TableId: > 0, At: not null } b) { ContinueBooking(); return; }
        var (reservation, error) = await Api.CreateReservationAsync(
            new OwnerReserveRequest(b.TableId, null, b.Guests, b.At.Value));
        _booking = null;
        if (reservation is null)
        {
            Bot(string.Format(TT("pbot.bookFailed"), error ?? ""), new Chip($"📅 {L["nav.reservations"]}", "nav:/reservations"));
            return;
        }
        _messages.Add(new Msg
        {
            FromBot = true,
            Text = string.Format(TT("pbot.booked"), reservation.TableName),
            Rows = [new Row($"🍽️ {reservation.TableName}", reservation.Name,
                $"👥 {reservation.Guests} · ✓",
                reservation.At.Date == DateTime.Today ? reservation.At.ToString("HH:mm") : reservation.At.ToString("ddd HH:mm"))],
            Chips = [new Chip($"📅 {L["nav.reservations"]}", "nav:/reservations")],
        });
    }

    /// <summary>"نوشابه رو حذف کن" — take matching lines off the pending order.</summary>
    private void RemoveFromDraft(string raw)
    {
        var command = PosBotNlu.Parse(raw);
        var removed = false;
        foreach (var want in command.Items.Where(w => w.Query.Length > 0))
        {
            var query = want.Query;
            var hit = _draft.FirstOrDefault(d =>
                PosBotNlu.Fold(d.Item.NameFor(L.Locale)).Contains(query) ||
                PosBotNlu.Fold(d.Item.Name).Contains(query) ||
                MatchItem(query).Best?.Id == d.Item.Id);
            if (hit.Item is not null) { _draft.Remove(hit); removed = true; }
        }
        if (!removed) { Bot(string.Format(TT("pbot.notFound"), string.Join(" ", command.Items.Select(i => i.Query)))); return; }
        if (_draft.Count == 0) { _draftTable = null; Bot(TT("pbot.cancelled")); return; }
        ShowDraft();
    }

