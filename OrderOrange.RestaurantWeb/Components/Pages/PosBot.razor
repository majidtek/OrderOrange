    // ══════════════ answers about the business (parser: PosBotNlu.DetectAsk) ══════════════
    //
    // Each of these reads the same endpoints the corresponding PAGE reads, so the number
    // the assistant says and the number the owner sees if they go and look are the same
    // number. None of them invent a figure, and every one offers the page as a chip —
    // an answer in a chat bubble is a starting point, not a replacement for the report.

    private async Task AnswerAsync(PosBotNlu.Asked asked, string raw)
    {
        switch (asked.Kind)
        {
            case PosBotNlu.Ask.StockLevel: await StockLevelAsync(asked.Subject!); return;
            case PosBotNlu.Ask.StockLow: await StockLowAsync(); return;
            case PosBotNlu.Ask.StaffCount: await StaffCountAsync(); return;
            case PosBotNlu.Ask.TeamOnline: await TeamOnlineAsync(); return;
            case PosBotNlu.Ask.Payroll: await PayrollAsync(); return;
            case PosBotNlu.Ask.TopCustomers: await CustomersAsync(top: true, raw); return;
            case PosBotNlu.Ask.CustomerCount: await CustomersAsync(top: false, raw); return;
            case PosBotNlu.Ask.Rating: await RatingAsync(); return;
            case PosBotNlu.Ask.BillsUnpaid: await BillsAsync(); return;
            case PosBotNlu.Ask.Visits: await VisitsAsync(raw); return;
            case PosBotNlu.Ask.StoreStatus: await ShopStatusAsync(); return;
            case PosBotNlu.Ask.StoreOpen: await ShopToggleAsync(wantOpen: true); return;
            case PosBotNlu.Ask.StoreClose: await ShopToggleAsync(wantOpen: false); return;
            case PosBotNlu.Ask.Deliveries: await DeliveriesAsync(); return;
            case PosBotNlu.Ask.AvgOrder: await SalesShapeAsync(raw, average: true); return;
            case PosBotNlu.Ask.Cancelled: await SalesShapeAsync(raw, average: false); return;
            case PosBotNlu.Ask.WorstItems: await WorstItemsAsync(raw); return;
            case PosBotNlu.Ask.Navigate: NavigateFlow(asked.Subject!); return;
            case PosBotNlu.Ask.Briefing: await BriefingAsync(); return;
            case PosBotNlu.Ask.CustomerSpend: await CustomerSpendAsync(asked.Subject!, raw); return;
            case PosBotNlu.Ask.OrderStatus: await OrderStatusAsync(asked.Subject!); return;
            case PosBotNlu.Ask.SamePeriodAgain: await RepeatAsync(raw); return;
            case PosBotNlu.Ask.MoreOfTheSame: await MoreAsync(); return;
            case PosBotNlu.Ask.Report: await ReportAsync(asked.Subject, raw); return;
        }
    }

    /// <summary>
    /// "give me a report on X". Every report in the portal is reachable from here: the
    /// assistant names the one it matched, says the headline figure so the answer is
    /// useful on its own, and hands over the page — which is where Excel and A4 live.
    /// With no topic named it lists what there is, because "give me a report" is a
    /// reasonable thing to say and guessing which one would be worse than asking.
    /// </summary>
    private async Task ReportAsync(string? topic, string raw)
    {
        // Each report carries its name in the reply language AND in English. Someone may
        // type "report on products" while the portal — and therefore the label — is in
        // Farsi; matching only the localised title would send them to the wrong report.
        (string Key, string Href, string Emoji)[] catalogue =
        [
            ("nav.sales", "/reports", "📊"),
            ("prep.title", "/reports/products", "🍽️"),
            ("crep.title", "/reports/customers", "👥"),
            ("billrep.title", "/bills/report", "🧾"),
            ("salrep.title", "/staff/salary-report", "💸"),
            ("cons.title", "/materials/report", "📦"),
            ("vis.title", "/visits", "📈"),
            ("ua.title", "/team-activity", "📡"),
        ];

        var reports = catalogue
            .Select(c => (Label: TT(c.Key), English: LanguageService.Translate("en", c.Key), c.Href, c.Emoji))
            .ToArray();

        // Nothing named: offer the shelf of reports rather than picking one.
        if (string.IsNullOrWhiteSpace(topic))
        {
            _messages.Add(new Msg
            {
                FromBot = true,
                Text = TT("pbot.whichReport"),
                Chips = reports.Select(r => new Chip($"{r.Emoji} {r.Label}", $"nav:{r.Href}")).ToArray().ToList(),
            });
            return;
        }

        // Subject words first — they are unambiguous and language-aware in a way a title
        // match is not. "products" must reach the product report even when its title
        // reads «گزارش محصولات», and "stock" must reach the consumption report whose
        // title mentions neither word.
        var folded = PosBotNlu.Fold(topic);
        var hit =
            PosBotNlu.MentionsProducts(folded) ? reports[1]
            : PosBotNlu.MentionsCustomers(folded) ? reports[2]
            : PosBotNlu.MentionsStock(folded) ? reports[5]
            : PosBotNlu.MentionsPeople(folded) ? reports[4]
            : PosBotNlu.MentionsMoneyOwed(folded) ? reports[3]
            : reports
                .Select(r => (R: r, M: Fuzzy.Best(topic, r.Label, r.English)))
                .Where(x => x.M.Ok)
                .OrderByDescending(x => x.M.Score)
                .Select(x => x.R)
                .FirstOrDefault();

        // Nothing recognised: sales is the report an owner means by default.
        if (hit.Href is null) hit = reports[0];

        // A headline figure, so the reply is worth something before they tap anything.
        var period = PeriodKey(PosBotNlu.DetectPeriod(raw));
        var headline = "";
        if (hit.Href == "/reports" || hit.Href == "/reports/products" || hit.Href == "/reports/customers")
        {
            var sales = await Api.GetMySalesReportAsync(period);
            if (sales is not null)
                headline = string.Format(TT("pbot.reportHead"), sales.Orders, Fmt.Money(sales.Revenue));
        }

        _messages.Add(new Msg
        {
            FromBot = true,
            Text = string.Format(TT("pbot.reportIs"), hit.Label)
                   + (headline.Length > 0 ? " " + headline : ""),
            Chips =
            [
                new Chip($"{hit.Emoji} {TT("pbot.openReport")}", $"nav:{hit.Href}"),
                new Chip($"📗 {TT("exp.excel")}", $"nav:{hit.Href}"),
            ],
        });
    }

    /// <summary>
    /// Changes the whole portal's language, not merely the reply. Asking an assistant to
    /// "switch to Arabic" means the app, and changing only the chat bubbles would be a
    /// strange half-measure.
    ///
    /// The confirmation is written in the NEW language — it is the first proof that the
    /// change took — and the conversation's own reply language is pinned to it too, so a
    /// later message with no language signal stays where the owner just put it.
    /// </summary>
    private async Task SwitchLanguageAsync(string code)
    {
        if (L.Locale == code)
        {
            _replyLocale = code;
            Bot(string.Format(LanguageService.Translate(code, "pbot.langAlready"),
                LanguagePick.NativeName(code)));
            return;
        }

        await L.SetLocaleAsync(code);
        _replyLocale = code;
        Bot(string.Format(LanguageService.Translate(code, "pbot.langNow"),
            LanguagePick.NativeName(code)));
    }

    /// <summary>
    /// A sum, with its working shown. The result is written plainly rather than as money:
    /// "2 + 2" is four of something, and guessing it is four rials would be worse than
    /// saying nothing. A calculation that happens to look like a price gets a currency
    /// chip instead, so the owner decides.
    /// </summary>
    private void ShowSum(PosBotNlu.Sum sum)
    {
        // Whole numbers print whole. Nobody wants "4.0000" back from "2 + 2".
        var pretty = Math.Abs(sum.Value % 1) < 0.0000001
            ? sum.Value.ToString("N0")
            : sum.Value.ToString("0.####");

        _messages.Add(new Msg
        {
            FromBot = true,
            Text = $"{sum.Expression} = {pretty}",
            Rows =
            [
                new Row("🧮", pretty, sum.Expression, ""),
            ],
        });
    }

    /// <summary>
    /// The date or the clock. The date answer carries a second calendar for readers who
    /// use one — Jalali for Persian, Hijri for Arabic — because that is the number they
    /// would actually write down.
    /// </summary>
    private void ShowClock(PosBotNlu.Clock kind)
    {
        var now = DateTime.Now;
        var locale = _replyLocale ?? L.Locale;

        var (text, pill, detail) = kind switch
        {
            PosBotNlu.Clock.Time => (
                string.Format(TT("pbot.timeIs"), PosBotNlu.DescribeTime(now, locale)),
                "🕒", PosBotNlu.DescribeDate(now, locale)),
            PosBotNlu.Clock.Weekday => (
                string.Format(TT("pbot.dayIs"), PosBotNlu.DescribeWeekday(now, locale)),
                "📆", PosBotNlu.DescribeDate(now, locale)),
            _ => (
                string.Format(TT("pbot.dateIs"), PosBotNlu.DescribeDate(now, locale)),
                "📅", PosBotNlu.DescribeTime(now, locale)),
        };

        _messages.Add(new Msg
        {
            FromBot = true,
            Text = text,
            Rows = [new Row(pill, detail, "", "")],
        });
    }

    /// <summary>
    /// The whole shop in one message: money, the live board, the shelf, the people. This
    /// is the answer to "how are we doing?", which is the question an owner actually asks
    /// — not any one of the numbers below on its own.
    /// </summary>
    private async Task BriefingAsync()
    {
        var sales = await Api.GetMySalesReportAsync("day");
        var board = await Api.GetRestaurantBoardAsync() ?? [];
        var stock = await Api.GetMaterialsAsync();
        var team = await Api.GetTeamActivityAsync() ?? [];

        var rows = new List<Row>
        {
            new("💰", TT("pbot.brToday"),
                string.Format(TT("pbot.brOrders"), sales?.Orders ?? 0),
                Fmt.Money(sales?.Revenue ?? 0)),
            new("🔥", TT("pbot.brLive"),
                string.Format(TT("pbot.brPending"), board.Count(o => o.Status == OrderStatus.Pending)),
                board.Count.ToString()),
        };

        if (stock is not null)
            rows.Add(new Row(stock.OutCount > 0 ? "🚫" : stock.LowCount > 0 ? "⚠️" : "📦",
                TT("mat.title"),
                string.Format(TT("pbot.brStock"), stock.OutCount, stock.LowCount),
                stock.Items.Count.ToString()));

