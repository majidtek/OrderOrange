@page "/pos"
@page "/pos/{TableId:int}"
@page "/pos-tablet"
@page "/pos-tablet/{TableId:int}"
@using OrderOrange.RestaurantWeb.Services
@inject ApiClient Api
@inject AppState State
@inject LanguageService L
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IJSRuntime JS
@inject ReceiptPrinter Printer
@implements IDisposable

@* The till. A full POS screen: product tiles on one side, the live ticket on the
   other. Works two ways — bound to a table (the table's open invoice) or with no
   table at all (a counter sale: tap, pay, next customer). *@

<PageTitle>OrderOrange — POS</PageTitle>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Class="mx-auto d-block my-8" />
}
else if (_menu is not null)
{
    <div class="pos @(Tablet ? "tablet" : "")">
        <div class="pos-left">
            <div class="pos-top">
                <div class="pos-mode top">
                    <button type="button" class="@(_table is null ? "on" : "")" @onclick="@(() => SwitchTo(null))">
                        🥡 @L["pos.counter"]
                    </button>
                    <button type="button" class="@(_table is not null ? "on" : "")" @onclick="PickTable">
                        🍽️ @(_table?.Name ?? L["pos.pickTable"]) ▾
                    </button>
                </div>
                <button type="button" class="pos-custbtn top" disabled="@(TabMode && _table is null)" @onclick="PickCustomer">
                    👤 @CustomerLabel <span class="chev">▾</span>
                </button>
                @if (TabMode)
                {
                    @* The open invoice's running number — quote it, find it in the list. *@
                    <span class="pos-invno">@L["tables.invoice"] <b>@_tab!.Id</b></span>
                }
                @if (_openTabCount > 0)
                {
                    <button type="button" class="pos-custbtn hot top" @onclick="ShowOpenTabs">
                        🧾 <span class="badge-n">@_openTabCount</span> <span class="chev">▾</span>
                    </button>
                }
                <MudSpacer />
                @* Scan-and-type: a product code (or barcode wand) + Enter drops it on the
                   ticket. Tapping the box also opens a touch numpad — a tablet till has
                   no keys of its own. *@
                <div class="pos-code mf-ltr">
                    <span class="ic">⌨</span>
                    <input id="pos-code" placeholder="@L["pos.codeHint"]" @bind="_codeEntry" @bind:event="oninput"
                           @onkeydown="OnCodeKeyAsync" @onfocus="@(() => _padOpen = true)" autocomplete="off" />
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Keyboard" Size="Size.Medium"
                               OnClick="@(() => _hkOpen = !_hkOpen)" title="@L["pos.hk.title"]" />
                <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Medium" OnClick="@(() => StartTour())" />
                <MudIconButton Icon="@Icons.Material.Filled.Search" Size="Size.Medium" OnClick="OpenSearch" />
            </div>

            <div class="pos-cats-row">
                <button type="button" class="pos-cat-arrow"
                        @onclick="@(() => JS.InvokeVoidAsync("mfPos.slideCats", ".pos-cats", -1))">‹</button>
                <div class="pos-cats">
                    @foreach (var c in _menu)
                    {
                        var cat = c;
                        <button type="button" class="@(_categoryId == cat.Id ? "on" : "")" @onclick="@(() => SetCategory(cat.Id))">
                            @cat.NameFor(L.Locale)
                        </button>
                    }
                </div>
                <button type="button" class="pos-cat-arrow"
                        @onclick="@(() => JS.InvokeVoidAsync("mfPos.slideCats", ".pos-cats", 1))">›</button>
            </div>

            <div class="pos-grid @(_catLoading ? "loading" : "")" @key="_categoryId">
                @foreach (var item in VisibleItems)
                {
                    var dish = item;
                    var pendingQty = _pending.GetValueOrDefault(dish.Id);
                    // What is already on THIS open invoice, so reopening a table shows the counts.
                    var savedQty = DraftLines.Where(l => l.MenuItemId == dish.Id).Sum(l => l.Quantity);
                    var qty = pendingQty + savedQty;
                    <button type="button" class="pos-tile @(qty > 0 ? "on" : "")" @onclick="@(() => Bump(dish, 1))">
                        @if (qty > 0)
                        {
                            <span class="pt-badge">@qty</span>
                            <span class="pt-minus" @onclick="@(() => Bump(dish, -1))" @onclick:stopPropagation="true">−</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(dish.Photo))
                        {
                            <img class="pt-img" src="@dish.Photo" alt="" loading="lazy" />
                        }
                        else if (FoodPhoto.ForDish(dish.Name, _stockPhotos) is string stockPhoto)
                        {
                            <img class="pt-img" src="@stockPhoto" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span class="pt-emoji">@(string.IsNullOrWhiteSpace(dish.ImageEmoji) ? "🍽️" : dish.ImageEmoji)</span>
                        }
                        <span class="pt-name">@dish.NameFor(L.Locale)</span>
                        <span class="pt-price mf-ltr">@Fmt.Rial(dish.FinalPrice)</span>
                        @if (_capacity.TryGetValue(dish.Id, out var canMake))
                        {
                            @* The shelf speaks on the tile: how many are still makeable,
                               live — what's already rung on this ticket counts against it. *@
                            var left = canMake - _pending.GetValueOrDefault(dish.Id);
                            <span class="pt-cap mf-ltr @(left <= 0 ? "out" : left < 10 ? "low" : "")">
                                @(left <= 0 ? "0" : $"×{left}")
                            </span>
                        }
                    </button>
                }
                @if (string.IsNullOrWhiteSpace(_search) && PosPages > 1)
                {
                    @* Six tiles a page. The bar lives INSIDE the grid as a full-width
                       row, so it sits right under the last tile — not at the bottom
                       of a stretched column with a gulf of nothing above it. *@
                    <div class="pg-bar pos-pg">
                        <button type="button" disabled="@(PosPage == 0)" @onclick="@(() => _posPage = PosPage - 1)">‹</button>
                        <span class="pg-info">@(PosPage + 1) / @PosPages</span>
                        <button type="button" disabled="@(PosPage + 1 >= PosPages)" @onclick="@(() => _posPage = PosPage + 1)">›</button>
                    </div>
                }
            </div>
        </div>

        <aside class="pos-ticket @(Tablet ? "sheet" : "") @(Tablet && _ticketOpen ? "open" : "")">
            @if (Tablet)
            {
                <button type="button" class="pos-tkt-x" @onclick="@(() => _ticketOpen = false)">✕</button>
            }
            <div class="pos-lines">
                @if (SavedLines.Count == 0 && _pending.Count == 0)
                {
                    <div class="pos-empty">@L["tab.noLines"]</div>
                }
                @foreach (var line in DraftLines)
                {
                    var saved = line;
                    <div class="pos-line">
                        <span class="step">
                            @* At quantity 1 the minus turns into a bin — one tap strikes the line. *@
                            <button type="button" class="pm @(saved.Quantity == 1 ? "del" : "")"
                                    @onclick="@(() => NudgeLine(saved, -1))">
                                @if (saved.Quantity == 1)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Style="width:14px;height:14px;" />
                                }
                                else
                                {
                                    <text>−</text>
                                }
                            </button>
                            <span class="q">@saved.Quantity</span>
                            <button type="button" class="pm" @onclick="@(() => NudgeLine(saved, 1))">+</button>
                        </span>
                        <span class="nm">@saved.Name</span>
                        <span class="pr mf-ltr">@Fmt.Rial(saved.UnitPrice * saved.Quantity)</span>
                        @* Pencil opens a note box for the kitchen; lit when the line carries one. *@
                        <button type="button" class="pm note @(NoteShown("s" + saved.Id, saved.Notes) ? "on" : "")"
                                title="@L["pos.kitchenNote"]" @onclick="@(() => ToggleNote("s" + saved.Id))">
                            <MudIcon Icon="@Icons.Material.Filled.EditNote" Style="width:16px;height:16px;" />
                        </button>
                    </div>
                    @if (NoteShown("s" + saved.Id, saved.Notes))
                    {
                        @* A note for the kitchen on a line already on the invoice — saved on the spot. *@
                        <input type="text" class="pos-line-note" maxlength="200" placeholder="@L["pos.kitchenNote"]"
                               value="@saved.Notes" @onchange="@(e => SetSavedNote(saved, e.Value as string))" />
                    }
                }
                @foreach (var entry in _pending)
                {
                    var dish = ItemById(entry.Key);
                    if (dish is null) { continue; }
                    var qty = entry.Value;
                    <div class="pos-line fresh">
                        <span class="step">
                            <button type="button" class="pm @(qty == 1 ? "del" : "")" @onclick="@(() => Bump(dish, -1))">
                                @if (qty == 1)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Style="width:14px;height:14px;" />
                                }
                                else
                                {
                                    <text>−</text>
                                }
                            </button>
                            <span class="q">@qty</span>
                            <button type="button" class="pm" @onclick="@(() => Bump(dish, 1))">+</button>
                        </span>
                        <span class="nm">@dish.NameFor(L.Locale)</span>
                        <span class="pr mf-ltr">@Fmt.Rial(dish.FinalPrice * qty)</span>
                        <button type="button" class="pm note @(NoteShown("p" + entry.Key, NoteFor(entry.Key)) ? "on" : "")"
                                title="@L["pos.kitchenNote"]" @onclick="@(() => ToggleNote("p" + entry.Key))">
                            <MudIcon Icon="@Icons.Material.Filled.EditNote" Style="width:16px;height:16px;" />
                        </button>
                    </div>
                    @if (NoteShown("p" + entry.Key, NoteFor(entry.Key)))
                    {
                        @* Per-product note for the kitchen — same idea as the customer app's per-dish note. *@
                        <input type="text" class="pos-line-note" maxlength="200" placeholder="@L["pos.kitchenNote"]"
                               value="@_notes.GetValueOrDefault(entry.Key)"
                               @onchange="@(e => SetLineNote(entry.Key, e.Value as string))" />
                    }
                }
            </div>

            <div class="pos-totals">
                <div><span>@L["cust.itemsTotal"]</span><b class="mf-ltr">@Fmt.Rial(PreviewSubtotal)</b></div>
                @if (PreviewSubtotal > 0)
                {
                    @if (ServiceFee > 0)
                    {
                        <div><span>@L["common.serviceFee"]</span><b class="mf-ltr">@Fmt.Rial(ServiceFee)</b></div>
                    }
                    @if (TaxPercent > 0)
                    {
                        <div><span>@L["common.tax"] (@TaxPercent.ToString("0.#")%)</span><b class="mf-ltr">@Fmt.Rial(PreviewTax)</b></div>
                    }
                }
                <div class="grand"><span>@L["tab.total"]</span><b class="mf-ltr">@Fmt.Rial(PreviewTotal)</b></div>
            </div>

            <div class="pos-pay-mode">
                <button type="button" class="@(_payment == PaymentMethod.CashOnDelivery ? "on" : "")"
                        @onclick="@(() => _payment = PaymentMethod.CashOnDelivery)">💵 @L["pos.cash"]</button>
                <button type="button" class="@(_payment == PaymentMethod.CardOnDelivery ? "on" : "")"
                        @onclick="@(() => _payment = PaymentMethod.CardOnDelivery)">💳 @L["pos.card"]</button>
            </div>

            @* Card payment: hand the amount to the till app so the cashier reads it off
               a big screen at the card terminal instead of retyping it from here. *@
            @if (_payment == PaymentMethod.CardOnDelivery && PreviewTotal > 0)
            {
                <button type="button" class="pos-till @(_tillSent ? "sent" : "")" disabled="@_tillSent" @onclick="SendToTill">
                    <MudIcon Icon="@(_tillSent ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.PointOfSale)" />
                    <span>@(_tillSent ? L["pos.tillSentMsg"] : L["pos.sendTill"])</span>
                </button>
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_error</MudAlert>
            }

            @if (TabMode)
            {
                @* A table's bill has two endings: parked open for later rounds, or settled now. *@
                @if (SavedLines.Count > 0 || _pending.Count > 0)
                {
                    <div class="pos-endings">
                        <button type="button" class="pos-end keep @(Dirty ? "dirty" : "")" disabled="@_busy" @onclick="@(() => SaveTicket(true))">
                            <MudIcon Icon="@Icons.Material.Filled.Save" />
                            <span><b>@L["pos.saveOpen"]</b></span>
                        </button>
                        <button type="button" class="pos-end pay" disabled="@_busy" @onclick="@(() => SaveTicket(false))">
                            <MudIcon Icon="@Icons.Material.Filled.Paid" />
                            @* The total already stands above in the bill; repeating it on
                               the button only crowds it. *@
                            <span><b>@L["pos.saveClose"]</b></span>
                        </button>
                    </div>
                }
                else
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true" Disabled="_busy" OnClick="CancelTab">
                        @L["tab.cancelTab"]
                    </MudButton>
                }
            }
            else if (_pending.Count > 0)
            {
                @* Park the bill open (paid later, no table needed), or take the money now. *@
                <div class="pos-endings">
                    <button type="button" class="pos-end keep @(Dirty ? "dirty" : "")" disabled="@_busy" @onclick="@(() => SaveTicket(true))">
                        <MudIcon Icon="@Icons.Material.Filled.Save" />
                        <span><b>@L["pos.saveOpen"]</b></span>
                    </button>
                    <button type="button" class="pos-end pay" disabled="@_busy" @onclick="@(() => SaveTicket(false))">
                        <MudIcon Icon="@Icons.Material.Filled.Paid" />
                        <span><b>@L["tab.closePay"]</b></span>
                    </button>
                </div>
            }
        </aside>

        @if (Tablet)
        {
            @* The bill lives in a dialog on the tablet: the food wall gets the whole
               screen, and this floating basket opens the sheet. *@
            <div class="pos-tkt-veil @(_ticketOpen ? "show" : "")" @onclick="@(() => _ticketOpen = false)"></div>
            @* The basket only exists once something is in it — an empty bill has nothing to show. *@
            @if (TicketCount > 0)
            {
                <button type="button" class="pos-tkt-fab @(_ticketOpen ? "hide" : "")" @onclick="@(() => _ticketOpen = true)">
                    <span class="ic">🧾</span>
                    <span class="c" @key="TicketCount">@TicketCount</span>
                    <b class="mf-ltr">@Fmt.Rial(PreviewTotal)</b>
                </button>
            }
        }
    </div>

    @* ---------- Guided tour: a spotlight walks a new cashier through the register ---------- *@
    <GuidedTour @ref="_tour" Steps="@(Tablet ? TabletTourSteps : PosTourSteps)" OnStep="OnTourStep" OnEnded="OnTourEnded" />

    @* ---------- The touch numpad — at page root so no header stacking context
       can pull it under the product tiles; JS pins it below the code box. ---------- *@
    @if (_padOpen)
    {
        <div class="pos-pad" @onmousedown:preventDefault>
            <div class="val mf-ltr">@(_codeEntry.Length == 0 ? " " : _codeEntry)</div>
            <div class="keys">
                @foreach (var k in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9", "*", "0", "⌫" })
                {
                    <button type="button" class="@(k is "⌫" or "*" ? "alt" : "")"
                            @onclick="@(() => PadPress(k))">@k</button>
                }
            </div>
            <div class="row">
                <button type="button" class="x" @onclick="@(() => { _codeEntry = ""; _padOpen = false; })">✕</button>
                <button type="button" class="go" @onclick="PadApplyAsync">⏎ @L["common.add"]</button>
            </div>
        </div>
    }

    @* ---------- The cheat sheet: every key the till listens for ---------- *@
    @if (_hkOpen)
    {
        <div class="hk-veil" @onclick="@(() => _hkOpen = false)"></div>
        <div class="hk-card">
            <div class="hd">⌨️ @L["pos.hk.title"] <button type="button" @onclick="@(() => _hkOpen = false)">✕</button></div>
            <div class="grid">
                <div><kbd>@L["pos.hk.codeKeys"]</kbd><span>@L["pos.hk.code"]</span></div>
                <div><kbd>K</kbd><span>@L["pos.hk.focusCode"]</span></div>
                <div><kbd>S</kbd> <kbd>F3</kbd><span>@L["pos.hk.search"]</span></div>
                <div><kbd>T</kbd> <kbd>F6</kbd><span>@L["pos.hk.table"]</span></div>
                <div><kbd>C</kbd> <kbd>F7</kbd><span>@L["pos.hk.customer"]</span></div>
                <div><kbd>O</kbd> <kbd>F8</kbd><span>@L["pos.hk.tabs"]</span></div>
                <div><kbd>F2</kbd><span>@L["pos.hk.save"]</span></div>
                <div><kbd>P</kbd><span>@L["pos.hk.pay"]</span></div>
                <div><kbd>F9</kbd> / <kbd>F10</kbd><span>@L["pos.hk.payKind"]</span></div>
                <div><kbd>B</kbd><span>@L["pos.hk.till"]</span></div>
                <div><kbd>+</kbd> / <kbd>−</kbd><span>@L["pos.hk.qty"]</span></div>
                <div><kbd>N</kbd><span>@L["pos.hk.counter"]</span></div>
                <div><kbd>F</kbd><span>@L["pos.hk.fullscreen"]</span></div>
                <div><kbd>F1</kbd> <kbd>?</kbd><span>@L["pos.hk.title"]</span></div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int? TableId { get; set; }

    /// <summary>A parked bill with no table, reached as /pos?tab=123.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public int? TabQueryId { get; set; }

    private StoreTableDto? _table;
    private StoreTabDto? _tab;
    private List<StoreTableDto> _allTables = [];
    private List<MenuCategoryDto>? _menu;
    private Dictionary<int, int> _pending => State.PosPending;
    private string _search = "";
    private int _categoryId;

    // Twenty tiles a page, every tab — the ‹ › bar under the grid turns the shelf.
    // A hundred photo tiles at once is what made the till heavy.
    private const int PosSlice = 20;
    private int _posPage;

    // Groups whose photos have arrived. The till opens with the menu OUTLINE only (names,
    // prices, codes — light), and pulls a group's pictures the moment the cashier taps it.
    private readonly HashSet<int> _loadedCats = [];
    private bool _catLoading;

    private async Task SetCategory(int id)
    {
        _categoryId = id;
        _posPage = 0;
        await EnsureCategoryLoadedAsync(id);
    }

    /// <summary>Fetches one group's items with photos, once, and swaps them into the outline.</summary>
    private async Task EnsureCategoryLoadedAsync(int id)
    {
        if (id == 0 || _menu is null || _loadedCats.Contains(id)) return;
        var index = _menu.FindIndex(c => c.Id == id);
        if (index < 0) return;
        _catLoading = true;
        try
        {
            var items = await Api.GetMyCategoryItemsAsync(id);
            if (items is not null) _menu[index] = _menu[index] with { Items = items };
            _loadedCats.Add(id);
        }
        finally { _catLoading = false; }
    }

    /// <summary>The chosen group's whole shelf, before the page is cut from it.
    /// Falls back to the first group if the chosen one was deleted mid-shift.</summary>
    private List<MenuItemDto> PosPool =>
        (_menu!.FirstOrDefault(c => c.Id == _categoryId) ?? _menu!.FirstOrDefault())
            ?.Items.ToList() ?? [];

    private int PosPages => Math.Max(1, (PosPool.Count + PosSlice - 1) / PosSlice);
    private int PosPage => Math.Clamp(_posPage, 0, PosPages - 1);
    private decimal _storeTaxPercent;
    private bool _stockPhotos = true;
    private PaymentMethod _payment = PaymentMethod.CashOnDelivery;

    /// <summary>Product id → the cashier's kitchen note for that pending line.</summary>
    private Dictionary<int, string> _notes => State.PosNotes;

    /// <summary>Saves (or clears) a pending line's kitchen note.</summary>
    private void SetLineNote(int productId, string? note)
    {
        note = note?.Trim() ?? "";
        if (note.Length == 0) _notes.Remove(productId);
        else _notes[productId] = note;
    }

    /// <summary>The note for a product, trimmed to null — the shape PlaceOrderItem wants.</summary>
    // Which lines have their note box open — a line with a note is always open.
    private readonly HashSet<string> _noteOpen = [];
    private void ToggleNote(string key) { if (!_noteOpen.Remove(key)) _noteOpen.Add(key); }
    private bool NoteShown(string key, string? note) => _noteOpen.Contains(key) || !string.IsNullOrWhiteSpace(note);

    private string? NoteFor(int productId) =>
        _notes.TryGetValue(productId, out var n) && !string.IsNullOrWhiteSpace(n) ? n : null;
    private bool _loading = true;
    private bool _busy;
    private string? _error;

    /// <summary>Briefly true after the amount was handed to the till, so the button confirms.</summary>
    private bool _tillSent;

    /// <summary>Tablet only: the bill sheet is open.</summary>
    private bool _ticketOpen;

    private int TicketCount => DraftLines.Sum(l => l.Quantity) + _pending.Values.Sum();

    // ───────────── Guided tour (a fake first order, step by step) ─────────────

    private GuidedTour? _tour;

    /// <summary>The counter/table switch step — tappable, so the learner opens the floor themselves.</summary>
    private int TourSwitchStep => Tablet ? 4 : 3;

    /// <summary>The step that shows the REAL table list.</summary>
    private int TourTableStep => Tablet ? 5 : 4;

    private static readonly GuidedTour.Step[] PosTourSteps =
    [
        // Interactive steps: the spotlighted control really works — try the register.
        new(".pos-tile", "🍔", "pos.tour1t", "pos.tour1d", Interactive: true),
        new(".pos-ticket", "🧾", "pos.tour2t", "pos.tour2d", Interactive: true),
        new(".pos-pay-mode", "💵", "pos.tour3t", "pos.tour3d", Interactive: true),
        new(".pos-mode.top", "🍽️", "pos.tour4t", "pos.tour4d", Interactive: true),
        new(".mud-dialog", "🪑", "pos.tour6t", "pos.tour6d", Interactive: true),
        new(".pos-endings,.pos-pay,.pos-totals", "✅", "pos.tour5t", "pos.tour5d"),
    ];

    /// <summary>
    /// The tablet register is laid out differently — categories ride a top rail and the
    /// bill lives in a sheet — so its walkthrough visits different furniture. The bill,
    /// payment and finish steps stage the sheet open themselves.
    /// </summary>
    private static readonly GuidedTour.Step[] TabletTourSteps =
    [
        new(".pos-tile", "🍔", "pos.tour1t", "pos.tour1d", Interactive: true),
        new(".pos-cats-row", "🗂️", "pos.tour7t", "pos.tour7d", Interactive: true),
        new(".pos-ticket", "🧾", "pos.tour2t", "pos.tour2d", Interactive: true),
        new(".pos-pay-mode", "💵", "pos.tour3t", "pos.tour3d", Interactive: true),
        new(".pos-mode.top", "🍽️", "pos.tour4t", "pos.tour4d", Interactive: true),
        new(".mud-dialog", "🪑", "pos.tour6t", "pos.tour6d", Interactive: true),
        new(".pos-endings,.pos-pay,.pos-totals", "✅", "pos.tour5t", "pos.tour5d"),
    ];

    /// <summary>Tablet steps that need the bill sheet on screen.</summary>
    private static readonly int[] TabletSheetSteps = [2, 3, 6];

    private Task StartTour() => _tour?.StartAsync() ?? Task.CompletedTask;

    /// <summary>The floor plan the tour shows on the table step — closed again on leave.</summary>
    private IDialogReference? _tourTableDialog;

    private async Task OnTourStep(int step)
    {
        // Tablet: the bill/payment/finish steps happen inside the sheet — open it for them.
        if (Tablet) _ticketOpen = TabletSheetSteps.Contains(step);

        if (step == TourTableStep && _tourTableDialog is null)
        {
            // The real picker, live: the shield frames the dialog, so the cashier can
            // actually tap a table — picking one loads its bill like in real use.
            _tourTableDialog = await Dialogs.ShowAsync<PosTableDialog>("", new DialogOptions
            {
                FullScreen = true,
                CloseButton = true,
            });
            _ = WatchTourTableAsync(_tourTableDialog);
        }
        else if (step != TourTableStep && _tourTableDialog is not null)
        {
            _tourTableDialog.Close();
            _tourTableDialog = null;
        }
    }

    /// <summary>A table picked DURING the tour behaves like the real thing.</summary>
    private async Task WatchTourTableAsync(IDialogReference dialog)
    {
        var result = await dialog.Result;
        if (_tourTableDialog == dialog) _tourTableDialog = null;
        if (result?.Canceled == false && result.Data is StoreTableDto picked)
        {
            // The learner just DID this step. The navigation rebuilds the page, so the
            // tour's next position is parked in session state and resumed after it.
            State.PosTourResume = TourTableStep + 1;
            SwitchTo(picked.Id);
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Picks the tour back up after a table switch rebuilt the page.</summary>
    private async Task TryResumeTourAsync()
    {
        if (State.PosTourResume < 0 || _tour is null) return;
        var step = State.PosTourResume;
        State.PosTourResume = -1;
        await _tour.StartAtAsync(step);
    }

    private void OnTourEnded()
    {
        _tourTableDialog?.Close();
