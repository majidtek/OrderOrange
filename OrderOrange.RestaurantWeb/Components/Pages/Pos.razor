    private async Task OnCodeKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        await ApplyCodeAsync();
    }

    private void PadPress(string key)
    {
        if (key == "⌫") { if (_codeEntry.Length > 0) _codeEntry = _codeEntry[..^1]; return; }
        _codeEntry += key;
    }

    /// <summary>The pad's ⏎: ring it up and stay open for the next code.</summary>
    private Task PadApplyAsync() => ApplyCodeAsync();

    /// <summary>
    /// A barcode wand is a keyboard that types fast and presses Enter — this box
    /// serves both the wand and a cashier who knows the codes by heart.
    /// </summary>
    private async Task ApplyCodeAsync()
    {
        // Persian keyboards type ۵ — the parser must read it as 5.
        var raw = PosBotNlu.AsciiDigits(_codeEntry.Trim());
        if (raw.Length == 0) return;

        // CODE first, then how many: "5*3" rings product 5 three times.
        var qty = 1;
        var code = raw;
        var split = raw.Split('*', 'x', 'X', '×');
        if (split.Length == 2 && int.TryParse(split[1].Trim(), out var q) && q is > 0 and <= 99)
        {
            qty = q;
            code = split[0].Trim();
        }

        if (code.StartsWith("P", StringComparison.OrdinalIgnoreCase) &&
            int.TryParse(code[1..], out _)) code = code[1..];

        var available = _menu!.SelectMany(c => c.Items).Where(i => i.IsAvailable).OrderBy(i => i.Id).ToList();

        MenuItemDto? hit = null;
        if (int.TryParse(code, out var number))
        {
            // Plain numbers are the SEQUENCE the labels print: 1 is the first product.
            if (number >= 1 && number <= available.Count) hit = available[number - 1];
            hit ??= available.FirstOrDefault(i => i.Id == number);
        }
        else
        {
            // Words work too — "پیتزا⏎" rings it up when exactly one dish matches.
            var folded = PosBotNlu.Fold(code);
            var named = available.Where(i =>
                PosBotNlu.Fold(i.NameFor(L.Locale)).Contains(folded) ||
                PosBotNlu.Fold(i.Name).Contains(folded)).ToList();
            if (named.Count == 1) hit = named[0];
        }

        if (hit is null)
        {
            Snackbar.Add(string.Format(L["pos.codeNotFound"], raw), Severity.Warning);
            _codeEntry = "";
            return;
        }

        await Bump(hit, qty);
        _codeEntry = "";
        Snackbar.Add($"➕ {qty} × {hit.NameFor(L.Locale)}", Severity.Success);
        // The next scan should land here without a tap.
        try { await JS.InvokeVoidAsync("mfPos.focus", "#pos-code"); } catch { }
    }

