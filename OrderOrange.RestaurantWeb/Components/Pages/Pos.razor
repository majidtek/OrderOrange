    private IEnumerable<MenuItemDto> VisibleItems
    {
        get
        {
            // Typing sweeps the WHOLE menu — with no All tab, search is how the
            // cashier reaches a dish without knowing its shelf.
            if (!string.IsNullOrWhiteSpace(_search))
                return _menu!.SelectMany(c => c.Items)
                    .Where(i => i.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));
            return PosPool.Skip(PosPage * PosSlice).Take(PosSlice);
        }
    }

    private MenuItemDto? ItemById(int id) =>
        _menu?.SelectMany(c => c.Items).FirstOrDefault(i => i.Id == id);

    private const decimal PlatformFee = 0m; // mirrors Pricing.ServiceFee server-side (zero since 2026-08-28)

    private decimal PendingSum =>
        _pending.Sum(p => (ItemById(p.Key)?.FinalPrice ?? 0m) * p.Value);

    // The ticket previews EXACTLY what paying will bill: saved lines (in table mode)
    // plus the round on screen, the service fee, and VAT at the store's rate.
    private decimal TaxPercent => _tab?.TaxPercent ?? _storeTaxPercent;
    private decimal PreviewSubtotal => DraftLines.Sum(l => l.UnitPrice * l.Quantity) + PendingSum;
    private decimal ServiceFee => PreviewSubtotal > 0 ? PlatformFee : 0m;
    private decimal PreviewTax => Math.Round(PreviewSubtotal * TaxPercent / 100m, 3);
    private decimal PreviewTotal => PreviewSubtotal + ServiceFee + PreviewTax;

    protected override async Task OnParametersSetAsync()
    {
        // Crossing between /pos and /pos-tablet starts a clean round: the unsent
        // ring-up is dropped and the shelf turns back to its first page — the other
        // face of the till must not inherit a half-typed ticket. The last face is
        // remembered on the SESSION: a route change re-creates this component.
        if (State.PosLastTablet is { } wasTablet && wasTablet != Tablet)
        {
            _pending.Clear();
            _notes.Clear();
            _posPage = 0;
            _ticketOpen = false;
            _search = "";
        }
        State.PosLastTablet = Tablet;

        var key = $"{TableId ?? 0}:{TabQueryId ?? 0}";
        if (_loadedKey == key) return;
        _loadedKey = key;
        // Only the very first load gets a spinner — switching modes must not blank
        // the screen; the bar staying put is what makes the till feel solid.
        _loading = _menu is null;
        _error = null;
        _table = null;
        _tab = null;

        // The outline first (every group and item, no photos — a few KB), then only the
        // opening group's photos. Other groups load when tapped; a big menu no longer
        // drags a hundred pictures through the circuit before the first ring-up.
        // Everything the till needs is asked for AT ONCE — one round trip's worth of
        // waiting instead of five in a row — and the shelf is painted as soon as the
        // menu is in; store preferences, tables and open bills settle in behind it.
        var outlineTask = _menu is null ? Api.GetMyMenuOutlineAsync() : Task.FromResult<List<MenuCategoryDto>?>(_menu);
        var mineTask = _prefsLoaded ? null : Api.GetMyRestaurantAsync();
        var tablesTask = Api.GetTablesAsync();
        var tabsTask = Api.GetTabsAsync();

        _menu ??= await outlineTask ?? [];
        // No "All" tab any more: the till opens on the first group.
        if (_categoryId == 0) _categoryId = _menu.FirstOrDefault()?.Id ?? 0;
        await EnsureCategoryLoadedAsync(_categoryId);
        var counterMode = TabQueryId is not > 0 && TableId is not > 0;
        if (counterMode && _loading)
        {
            _loading = false;   // tiles first; the rest arrives while the cashier is already looking
            StateHasChanged();
        }
        if (mineTask is not null)
        {
            var mine = await mineTask;
            _storeTaxPercent = mine?.TaxPercent ?? 0m;
            _stockPhotos = mine?.DishStockPhotos ?? true;
            // The shop chose in Settings which ending its save button offers first.
            _defaultKeepOpen = mine?.PosDefaultOpen ?? true;
            _directPrint = mine?.DirectPrint ?? false;
            _keepOpen = _defaultKeepOpen;
            _prefsLoaded = true;
        }
        _allTables = await tablesTask ?? [];
        var openTabs = await tabsTask;
        _openTabCount = openTabs?.Count ?? 0;

        if (TabQueryId is { } tabId and > 0)
        {
            // A parked bill: no table, just the invoice itself.
            _tab = openTabs?.FirstOrDefault(t => t.Id == tabId);
            if (_tab is null) Nav.NavigateTo(Base);
        }
        else if (TableId is { } tableId and > 0)
        {
            _table = _allTables.FirstOrDefault(t => t.Id == tableId);
            if (_table is null)
            {
                Nav.NavigateTo(Base);
            }
            else
            {
                // The till never stops to ask questions: a free table is seated as a
                // walk-in on the spot, an occupied one hands over its running invoice.
                _tab = await Api.GetTabForTableAsync(_table.Id);
                if (_tab is null)
                {
                    var (tab, error) = await Api.OpenTabAsync(new OpenTabRequest(
                        _table.Id,
                        _table.StoreCustomerId,
                        _table.StoreCustomerId is null ? (_table.GuestName ?? "Walk-in") : null));
                    if (tab is null) { _error = error ?? L["common.saveFail"]; }
                    _tab = tab;
                }
            }
        }
        _loading = false;

        // Capacity numbers arrive after the till is usable — never before it.
        _ = LoadCapacityAsync();
    }

    /// <summary>The same till, sized for a tablet, lives under its own route.</summary>
    private bool Tablet => new Uri(Nav.Uri).AbsolutePath.StartsWith("/pos-tablet", StringComparison.OrdinalIgnoreCase);
    private string Base => Tablet ? "/pos-tablet" : "/pos";

    /// <summary>Move the sale: onto a table's invoice, or back to a plain counter sale.</summary>
    private void SwitchTo(int? tableId) =>
        Nav.NavigateTo(tableId is { } id ? $"{Base}/{id}" : Base);

    /// <summary>All running invoices in one list; picking one moves the till onto it.</summary>
    private async Task ShowOpenTabs()
    {
        var dialog = await Dialogs.ShowAsync<PosOpenTabsDialog>("", new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true,
        });
        var result = await dialog.Result;

        // Bills may have been settled inside the dialog — the count and, if the till
        // is sitting on an invoice, that very invoice must both be re-checked.
        var freshTabs = await Api.GetTabsAsync() ?? [];
        _openTabCount = freshTabs.Count;
        if (TabMode)
        {
            _tab = _table is not null
                ? await Api.GetTabForTableAsync(_table.Id)
                : freshTabs.FirstOrDefault(t => t.Id == _tab!.Id);
            if (_tab is null) { Nav.NavigateTo(Base); return; }
        }

        if (result?.Canceled != false) return;
        if (result.Data is StoreTabDto tab)
        {
            if (tab.TableId > 0) SwitchTo(tab.TableId);
            else Nav.NavigateTo($"{Base}?tab={tab.Id}");
        }
    }

    /// <summary>Attach the sale to a book customer — or back to an anonymous walk-up.</summary>
    private async Task PickCustomer()
    {
        var dialog = await Dialogs.ShowAsync<PosCustomerDialog>("", new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
            CloseButton = true,
        });
        var result = await dialog.Result;
        if (result?.Canceled != false) return;

        if (TabMode)
        {
            // Re-seat the table's party: the running invoice keeps its lines.
            var (tab, error) = result.Data is StoreCustomerDto picked
                ? await Api.OpenTabAsync(new OpenTabRequest(_table!.Id, picked.Id))
                : await Api.OpenTabAsync(new OpenTabRequest(_table!.Id, GuestName: L["pos.walkin"]));
            if (tab is null) { Snackbar.Add(error ?? L["common.updateFail"], Severity.Error); return; }
            _tab = tab;
        }
        else
        {
            _customer = result.Data as StoreCustomerDto; // sentinel → null → walk-up
        }
    }

    /// <summary>The floor in a dialog: pick the table for this sale, or manage tables.</summary>
    private async Task PickTable()
    {
        // Full screen: the floor plan deserves the whole display, like the till itself.
        var dialog = await Dialogs.ShowAsync<PosTableDialog>("", new DialogOptions
        {
            FullScreen = true,
            CloseButton = true,
        });

        // Opened from the tour's counter/table step? Then this IS the next step:
        // hand the dialog to the tour and slide the spotlight onto it.
        if (_tour?.CurrentStep == TourSwitchStep)
        {
            _tourTableDialog = dialog;
            await _tour.NextAsync();
        }

        var result = await dialog.Result;
        if (_tourTableDialog == dialog) _tourTableDialog = null;
        if (result?.Canceled != false) { _allTables = await Api.GetTablesAsync() ?? []; return; }
        if (result.Data is StoreTableDto picked)
        {
            // Picked during the tour? The navigation rebuilds this page, so the tour's
            // next position is parked in session state and picked up after the switch.
            if (_tour?.CurrentStep == TourTableStep) State.PosTourResume = TourTableStep + 1;
            SwitchTo(picked.Id);
        }
    }

    private async Task Bump(MenuItemDto item, int delta)
    {
        // On an open invoice a dish that is already on it grows in place — tapping the
        // tile again must not start a second line for the same dish. A dish that is
        // still only pending keeps collecting in the pending line.
        if (_tab is not null && !_pending.ContainsKey(item.Id))
        {
            var saved = DraftLines.LastOrDefault(l => l.MenuItemId == item.Id);
            if (saved is not null) { await NudgeLine(saved, delta); return; }
        }
        var next = _pending.GetValueOrDefault(item.Id) + delta;
        if (next <= 0) _pending.Remove(item.Id);
        else _pending[item.Id] = next;
    }

    private async Task<bool> SendRound()
    {
        if (_tab is null || !Dirty) return true;
        _busy = true;
        _error = null;
        try
        {
            // Edits to saved lines and the new items travel in ONE request, so the till
            // sees one change and the kitchen gets one ticket per save.
            var items = _pending.Select(p => new PlaceOrderItem(p.Key, p.Value, NoteFor(p.Key))).ToList();
            var edits = HasEdits
                ? _edits.Select(e => new TabLineEditRequest(e.Key, e.Value.Qty, e.Value.Notes ?? "")).ToList()
                : null;
            var (tab, error) = await Api.AddTabLinesAsync(_tab.Id, new AddTabLinesRequest(items, edits));
            if (tab is null) { _error = error ?? L["common.saveFail"]; return false; }
            _tab = tab;
            _edits.Clear();
            _pending.Clear();
            _notes.Clear();
            return true;
        }
        finally { _busy = false; }
    }

    /// <summary>+/− on a saved ticket line. Stepping down to zero strikes it.</summary>
    /// <summary>Writes the kitchen note onto a line that is already on the open invoice.</summary>
    private void SetSavedNote(TabLineDto line, string? note) =>
        Draft(line, line.Quantity, string.IsNullOrWhiteSpace(note) ? null : note.Trim());

    private Task NudgeLine(TabLineDto line, int delta)
    {
        Draft(line, Math.Max(0, line.Quantity + delta), line.Notes);
        return Task.CompletedTask;
    }

    private bool _prefsLoaded;
    private bool _defaultKeepOpen = true;
    private bool _keepOpen = true;

    /// <summary>Search lives in its own dialog; whatever it picks lands on the ticket.</summary>
    private async Task OpenSearch()
    {
        var parameters = new DialogParameters<PosSearchDialog> { { d => d.Menu, _menu ?? [] } };
        var dialog = await Dialogs.ShowAsync<PosSearchDialog>("", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not Dictionary<int, int> picked) return;
        foreach (var (id, qty) in picked)
        {
            _pending[id] = _pending.GetValueOrDefault(id) + qty;
        }
    }

    /// <summary>
    /// The two endings of a ticket, each with its own button. A hidden checkbox used
    /// to steer one green button, so the cashier could not tell whether pressing it
    /// would keep the table running or settle the bill.
    /// </summary>
    private Task SaveTicket(bool keepOpen)
    {
        _keepOpen = keepOpen;
        return SaveTicket();
    }

    private async Task SaveTicket()
    {
        if (_keepOpen)
        {
            if (TabMode) await SaveOpen();
            else await SaveOpenCounter();
        }
        else
        {
            await Pay();
        }
        // Back to the shop's chosen default for the next ticket.
        _keepOpen = _defaultKeepOpen;
    }

    private bool _directPrint;

    /// <summary>Direct printing lives in the layout now — one door for every page.</summary>
    private Task PrintDirect(OrderDto order) => Printer.PrintAsync(order);

    private Task Pay() => TabMode ? CloseTable() : PayCounter();

    /// <summary>Park the bill: commit the round on screen, keep the invoice open, next customer.</summary>
    private async Task SaveOpen()
    {
        if (!await SendRound()) return;
        Snackbar.Add(string.Format(L["pos.savedOpen"],
            _table?.Name ?? _tab!.CustomerName ?? _tab.GuestName ?? ""), Severity.Success);
        Nav.NavigateTo(Base);
    }

    /// <summary>Walk-up "save as open": a fresh parked bill, no table behind it.</summary>
    private async Task SaveOpenCounter()
    {
        if (_pending.Count == 0) return;
        _busy = true;
        _error = null;
        try
        {
            var (tab, error) = await Api.OpenTabAsync(new OpenTabRequest(
                0, _customer?.Id, _customer is null ? L["pos.walkin"].ToString() : null));
            if (tab is null) { _error = error ?? L["common.saveFail"]; return; }

            var items = _pending.Select(p => new PlaceOrderItem(p.Key, p.Value, NoteFor(p.Key))).ToList();
            var (filled, addError) = await Api.AddTabLinesAsync(tab.Id, new AddTabLinesRequest(items));
            if (filled is null) { _error = addError ?? L["common.saveFail"]; return; }

            Snackbar.Add(string.Format(L["pos.savedOpen"],
                filled.CustomerName ?? filled.GuestName ?? ""), Severity.Success);
            _pending.Clear();
            _notes.Clear();
            _customer = null;
            _openTabCount = (await Api.GetTabsAsync())?.Count ?? 0;
        }
        finally { _busy = false; }
    }

    /// <summary>Table mode: commit what's on screen, settle the invoice, back to the floor.</summary>
    private async Task CloseTable()
    {
        if (!await SendRound()) return;
        _busy = true;
        _error = null;
        try
        {
            var (order, error) = await Api.CloseTabAsync(_tab!.Id, new CloseTabRequest(_payment, MarkPaid: true));
            if (order is null) { _error = error ?? L["common.saveFail"]; return; }
            _notes.Clear();
            Snackbar.Add(string.Format(L["tab.closed"], order.Number), Severity.Success);
            if (_directPrint) await PrintDirect(order);
            // The bill is settled — the till stays open, back in walk-up mode for the next sale.
            Nav.NavigateTo(Base);
        }
        finally { _busy = false; }
    }

    /// <summary>Counter mode: one anonymous sale over the counter — paid, printed, next!</summary>
    private async Task PayCounter()
    {
        if (_pending.Count == 0) return;
        _busy = true;
        _error = null;
        try
        {
            var items = _pending.Select(p => new PlaceOrderItem(p.Key, p.Value, NoteFor(p.Key))).ToList();
            var (order, error) = await Api.PlaceCounterOrderAsync(new PlaceCounterOrderRequest(
                _customer?.Id ?? 0, _payment, items, MarkPaid: true, CounterSale: true));
            if (order is null) { _error = error ?? L["common.saveFail"]; return; }
            _notes.Clear();
            Snackbar.Add(string.Format(L["tab.closed"], order.Number), Severity.Success);
            if (_directPrint) await PrintDirect(order);
            _pending.Clear();
            _notes.Clear();
            _customer = null; // the till stays open — next customer, fresh bill
        }
        finally { _busy = false; }
    }

    private async Task CancelTab()
    {
        if (_tab is null) return;
        _busy = true;
        try
        {
            var (ok, error) = await Api.CancelTabAsync(_tab.Id);
            if (!ok) { _error = error ?? L["common.updateFail"]; return; }
            Nav.NavigateTo(Base);
        }
        finally { _busy = false; }
    }
}
