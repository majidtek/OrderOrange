<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LocalHandler</AssemblyName>
    <Version>1.1.17</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>LocalHandler</RootNamespace>
    <ApplicationTitle>OrderOrange Local Handler</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same DTOs the web apps use: an order printed here is the order the
         server sent, with no second definition to drift out of step. -->
    <ProjectReference Include="..\OrderOrange.Shared\OrderOrange.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />
    <!-- The same QR library the web receipt uses, so both draw an identical scannable code. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- Renders the receipt as the SAME HTML+CSS the web POS uses, and prints it silently. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is only here for the tray icon; keep its types out of the global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
