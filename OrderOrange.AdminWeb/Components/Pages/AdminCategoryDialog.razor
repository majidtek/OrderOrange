@inject ApiClient Api
@inject LanguageService L

<MudDialog>
    <DialogContent>
        <MudTextField Margin="Margin.Dense" @bind-Value="_name" Label="@L["common.name"]" Variant="Variant.Outlined" Class="mb-3" Immediate="true" />
        <MudNumericField Margin="Margin.Dense" @bind-Value="_sortOrder" Label="@L["partner.sortOrder"]" Variant="Variant.Outlined" />
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">@L["common.cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_busy">@L["common.save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public int RestaurantId { get; set; }
    [Parameter] public MenuCategoryDto? Existing { get; set; }

    private string _name = "";
    private int _sortOrder = 1;
    private string? _error;
    private bool _busy;

    protected override void OnInitialized()
    {
        if (Existing is null) return;
        _name = Existing.Name;
        _sortOrder = Existing.SortOrder;
    }

    private async Task Save()
    {
        _error = null;
        _busy = true;
        try
        {
            var request = new SaveCategoryRequest(_name, _sortOrder);
            var (ok, error) = Existing is null
                ? await Api.AdminCreateCategoryAsync(RestaurantId, request)
                : await Api.AdminUpdateCategoryAsync(Existing.Id, request);
            if (!ok) { _error = error; return; }
            Dialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _busy = false;
        }
    }
}
