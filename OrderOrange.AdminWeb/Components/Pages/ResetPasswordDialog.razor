@inject ApiClient Api
@inject LanguageService L

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Set a new password for <b>@UserName</b>. They can change it themselves afterwards.
        </MudText>
        @* mf-ltr because "show" swaps the type to plain text — the type-based rule stops applying. *@
        <MudTextField Margin="Margin.Dense" @bind-Value="_password" Label="@L["admin.newPw"]" Variant="Variant.Outlined" Immediate="true" Class="mf-ltr"
                      InputType="@(_show ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_show ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="() => _show = !_show" />
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">@L["common.cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save"
                   Disabled="@(_busy || _password.Length < 6)">@L["admin.setPw"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public int UserId { get; set; }
    [Parameter] public string UserName { get; set; } = "";

    private string _password = "";
    private bool _show;
    private string? _error;
    private bool _busy;

    private async Task Save()
    {
        _error = null;
        _busy = true;
        try
        {
            var (ok, error) = await Api.ResetUserPasswordAsync(UserId, _password);
            if (!ok) { _error = error; return; }
            Dialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _busy = false;
        }
    }
}
