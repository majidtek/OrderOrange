@page "/support"
@using OrderOrange.ClientCore.Services
@inject ApiClient Api
@inject LanguageService L
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@* The support desk: every partner ticket across the platform, newest activity first.
   Tiles filter, search finds by number, store or subject. *@

<PageTitle>Admin — Support desk</PageTitle>

<div class="tk-page">

<PageHeader Title="@L["tk.a.title"]" Subtitle="@L["tk.a.sub"]" />

@if (_page is null)
{
    <Loader FullPage="true" />
}
else
{
    var s = _page.Summary;
    <div class="tk-stats admin">
        <div class="tk-stat unread"><b>@s.Unread</b><span>@L["tk.stat.unread"]</span></div>
        <div class="tk-stat open"><b>@(s.Open + s.InProgress + s.Waiting)</b><span>@L["tk.stat.open"]</span></div>
        <div class="tk-stat prog"><b>@s.InProgress</b><span>@L["tk.stat.inProgress"]</span></div>
        <div class="tk-stat wait"><b>@s.Waiting</b><span>@L["tk.a.wait"]</span></div>
        <div class="tk-stat done"><b>@s.Resolved</b><span>@L["tk.stat.resolved"]</span></div>
        <div class="tk-stat closed"><b>@s.Closed</b><span>@L["tk.stat.closed"]</span></div>
    </div>

    <div class="tk-tabbar">
        <button type="button" class="tk-arrow" @onclick="@(() => Scroll(-1))" aria-label="◂">‹</button>
        <MudTabs Elevation="0" Rounded="true" Class="mb-3 tk-tabs" ActivePanelIndex="_tab" ActivePanelIndexChanged="OnTab">
            <MudTabPanel Text="@L["tk.stat.unread"]" Icon="@Icons.Material.Filled.MarkChatUnread" />
            <MudTabPanel Text="@L["tk.stat.open"]" Icon="@Icons.Material.Filled.MarkEmailUnread" />
            <MudTabPanel Text="@L["tk.stat.inProgress"]" Icon="@Icons.Material.Filled.Engineering" />
            <MudTabPanel Text="@L["tk.a.wait"]" Icon="@Icons.Material.Filled.HourglassBottom" />
            <MudTabPanel Text="@L["tk.stat.resolved"]" Icon="@Icons.Material.Filled.TaskAlt" />
            <MudTabPanel Text="@L["tk.stat.closed"]" Icon="@Icons.Material.Filled.DoneAll" />
            <MudTabPanel Text="@L["tk.tab.all"]" Icon="@Icons.Material.Filled.Inbox" />
        </MudTabs>
        <button type="button" class="tk-arrow" @onclick="@(() => Scroll(1))" aria-label="▸">›</button>
    </div>

    <MudTextField T="string" Value="_search" ValueChanged="OnSearch" Immediate="true" DebounceInterval="350"
                  Placeholder="@L["tk.a.search"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" Style="max-width: 380px;" />

    @if (Visible.Count == 0)
    {
        <EmptyState Emoji="🎧" Title="@L["tk.none"]" />
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="rounded-xl" Style="overflow-x: auto;">
            <MudTable T="SupportTicketDto" Items="Visible" Hover="true" Dense="true" Elevation="0" OnRowClick="@(e => Nav.NavigateTo($"/support/{e.Item!.Id}"))" RowClass="tk-trow">
                <HeaderContent>
                    <MudTh></MudTh>
                    <MudTh>#</MudTh>
                    <MudTh>@L["tk.a.store"]</MudTh>
                    <MudTh>@L["tk.f.subject"]</MudTh>
                    <MudTh>@L["tk.f.category"]</MudTh>
                    <MudTh>@L["tk.f.priority"]</MudTh>
                    <MudTh>@L["common.status"]</MudTh>
                    <MudTh>@L["tk.a.assignedCol"]</MudTh>
                    <MudTh>@L["tk.updatedCol"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@if (context.SupportUnread) { <i class="tk-newdot"></i> }</MudTd>
                    <MudTd Class="mf-ascii"><code>@context.Number</code></MudTd>
                    <MudTd><b>@context.RestaurantName</b><br /><small class="mf-ascii">#@context.RestaurantId · @context.OpenedByName</small></MudTd>
                    <MudTd><b>@context.Subject</b><br /><small>@(context.LastFrom == "support" ? "🎧 " : "🏪 ")@context.LastPreview</small></MudTd>
                    <MudTd>@SupportUi.CategoryEmoji(context.Category) @L[$"tk.c.{context.Category}"]</MudTd>
                    <MudTd><span class="prio" style="--c:@SupportUi.PriorityColor(context.Priority)">● @L[$"tk.p.{context.Priority}"]</span></MudTd>
                    <MudTd><span class="pill @SupportUi.StatusCss(context.Status)">@L[$"tk.s.{context.Status}"]</span></MudTd>
                    <MudTd>@(context.AssignedTo ?? "—")</MudTd>
                    <MudTd><small>@Fmt.TimeAgo(context.LastMessageAt, L)</small></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}


</div>

@code {
    private static readonly string[] Tabs = ["unread_support", "open", "in_progress", "waiting", "resolved", "closed", "all"];

    private SupportPageDto? _page;
    private int _tab = 1;                     // the desk opens on "Open"
    private string _search = "";
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _timer = new System.Threading.Timer(async _ => await InvokeAsync(async () => { await Load(); StateHasChanged(); }), null, 30000, 30000);
    }

    /// <summary>One trip for the whole desk; the tabs filter it in the browser, instantly.</summary>
    /// <summary>The arrows show only while the bar has somewhere left to scroll.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("mfSupport.watchTabs"); } catch { }
    }

    private async Task Scroll(int dir)
    {
        try { await JS.InvokeVoidAsync("mfSupport.scrollTabs", dir); } catch { }
    }

    private async Task Load() => _page = await Api.AdminSupportTicketsAsync("all", _search, 0, 200) ?? new([], 0, new(0, 0, 0, 0, 0, 0));

    /// <summary>Same rule the server uses for its own status filter.</summary>
    private List<SupportTicketDto> Visible =>
        (_page?.Items ?? []).Where(t => Tabs[_tab] switch
        {
            "unread_support" => t.SupportUnread,
            "open" => t.Status is "open" or "in_progress" or "waiting",
            "in_progress" => t.Status == "in_progress",
            "waiting" => t.Status == "waiting",
            "resolved" => t.Status == "resolved",
            "closed" => t.Status == "closed",
            _ => true,
        }).ToList();

    private void OnTab(int index) => _tab = Math.Clamp(index, 0, Tabs.Length - 1);

    private async Task OnSearch(string value) { _search = value; await Load(); }

    public void Dispose() => _timer?.Dispose();
}
