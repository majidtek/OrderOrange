@inject ApiClient Api
@implements IDisposable

@* The red count beside "Partner chat" in the admin drawer: store messages no
   administrator has opened yet. Polled every 20 s. *@

@if (_unread > 0)
{
    <span class="tk-navbadge">@(_unread > 99 ? "99+" : _unread.ToString())</span>
}

@code {
    private int _unread;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        _timer = new System.Threading.Timer(async _ => await InvokeAsync(async () => { await Refresh(); StateHasChanged(); }), null, 20000, 20000);
    }

    private async Task Refresh()
    {
        try { _unread = await Api.GetPartnerChatUnreadAsync(); } catch { }
    }

    public void Dispose() => _timer?.Dispose();
}
