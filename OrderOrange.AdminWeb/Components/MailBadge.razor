@inject ApiClient Api
@implements IDisposable

@* The red count beside "Mailbox" in the admin drawer: unread mail in info@. Every 2 min. *@

@if (_unread > 0)
{
    <span class="tk-navbadge">@(_unread > 99 ? "99+" : _unread.ToString())</span>
}

@code {
    private int _unread;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        _timer = new System.Threading.Timer(async _ => await InvokeAsync(async () => { await Refresh(); StateHasChanged(); }), null, 120000, 120000);
    }

    private async Task Refresh()
    {
        try { _unread = await Api.GetMailUnreadAsync(); } catch { }
    }

    public void Dispose() => _timer?.Dispose();
}
