{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "//": "Everything that reaches api.orderorange.com goes to the production API's loopback https endpoint (Kestrel exe, D:\\OrderOrange\\publish-api). Change the address here if the API ever moves.",
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "local": {
            "Address": "https://127.0.0.1:8520/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        }
      }
    }
  }
}
