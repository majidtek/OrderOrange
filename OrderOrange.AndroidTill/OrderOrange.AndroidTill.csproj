<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>OrderOrange.AndroidTill</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>OrderOrange Till</ApplicationTitle>
    <ApplicationId>com.orderorange.till</ApplicationId>
    <ApplicationDisplayVersion>1.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>3</ApplicationVersion>

    <!-- Android 7.0+: every E-POS style terminal sold in the last years runs at least this. -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <!-- Side-loaded on the terminal, so a plain APK rather than an app bundle. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- CS0618: WebView.Scale is obsolete but still the only synchronous way to read the zoom. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#F26B1D" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F26B1D" BaseSize="128,128" />
    <!-- Optional fonts for the ticket renderer (e.g. an Arabic/Persian face when the terminal has none). -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- The same QR library the web receipt and the Windows till use, so the code scans the same. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The DTOs the server speaks and the KitchenTicket HTML builder the partner designer previews with. -->
    <ProjectReference Include="..\OrderOrange.Shared\OrderOrange.Shared.csproj" />
  </ItemGroup>

</Project>
