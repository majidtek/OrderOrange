    private string BreadcrumbJsonLd => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "OrderOrange", ["item"] = WithLang(Lang) == CanonicalUrl && Lang != "en" ? $"{Site}/?lang={Lang}" : Site + "/" },
            new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = _seoName, ["item"] = CanonicalUrl },
        },
    }, JsonOpts);

    /// <summary>The SHOP as schema.org sees one — name, place, phone, kitchen, and its menu.</summary>
    private string? StoreJsonLd
    {
        get
        {
            if (_seoStore is not { } s) return null;
            var data = new Dictionary<string, object>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = s.StoreType == StoreType.Restaurant ? "Restaurant" : "Store",
                ["@id"] = CleanUrl + "#store",
                ["name"] = _seoName,
                ["url"] = CanonicalUrl,
                ["image"] = OgImage,
                ["inLanguage"] = Lang,
                ["address"] = new Dictionary<string, object>
                {
                    ["@type"] = "PostalAddress",
                    ["addressLocality"] = string.IsNullOrWhiteSpace(s.Area) ? "" : StoreText.Area(s.Area, Lang),
                },
                ["servesCuisine"] = _seoCuisines,
                ["paymentAccepted"] = "Cash, Card",
                ["parentOrganization"] = new Dictionary<string, object> { ["@id"] = Site + "/#org" },
            };
            if (!string.IsNullOrWhiteSpace(s.Description))
                data["description"] = StoreText.Description(s.Description, Lang);
            var phone = (s.Phone ?? "").Split(';', ',').Select(p => p.Trim()).FirstOrDefault(p => p.Length > 3);
            if (phone is not null) data["telephone"] = phone.StartsWith('+') ? phone : "+968 " + phone;
            if (s.MapLat is { } la && s.MapLng is { } ln)
                data["geo"] = new Dictionary<string, object> { ["@type"] = "GeoCoordinates", ["latitude"] = la, ["longitude"] = ln };
            if (s.RatingCount > 0 && s.Rating > 0)
                data["aggregateRating"] = new Dictionary<string, object> { ["@type"] = "AggregateRating", ["ratingValue"] = Math.Round(s.Rating, 1), ["ratingCount"] = s.RatingCount, ["bestRating"] = 5, ["worstRating"] = 1 };
            if (s.AllowsPickup)
                data["hasOfferCatalog"] = new Dictionary<string, object> { ["@type"] = "OfferCatalog", ["name"] = "Pickup and delivery" };

            // The menu, section by section, with prices in rials — the part a dish search reads.
            var sections = new List<object>();
            foreach (var c in _seoMenu.OrderBy(c => c.SortOrder))
            {
                var items = c.Items
                    .Where(i => i.IsAvailable && !i.InStoreOnly && i.Price > 0)
                    .OrderBy(i => i.SortOrder).Take(40)
                    .Select(i =>
                    {
                        var item = new Dictionary<string, object>
                        {
                            ["@type"] = "MenuItem",
                            ["name"] = i.NameFor(Lang),
                            ["offers"] = new Dictionary<string, object> { ["@type"] = "Offer", ["price"] = i.Price.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture), ["priceCurrency"] = "OMR" },
                        };
                        var d = i.DescriptionFor(Lang);
                        if (!string.IsNullOrWhiteSpace(d)) item["description"] = d;
                        if (i.Photo is { Length: > 0 } photo && photo.StartsWith("http", StringComparison.OrdinalIgnoreCase)) item["image"] = photo;
                        return (object)item;
                    }).ToList();
                if (items.Count == 0) continue;
                sections.Add(new Dictionary<string, object> { ["@type"] = "MenuSection", ["name"] = c.NameFor(Lang), ["hasMenuItem"] = items });
            }
            if (sections.Count > 0)
                data["hasMenu"] = new Dictionary<string, object> { ["@type"] = "Menu", ["name"] = _seoName, ["inLanguage"] = Lang, ["hasMenuSection"] = sections };
            return System.Text.Json.JsonSerializer.Serialize(data, JsonOpts);
        }
    }
