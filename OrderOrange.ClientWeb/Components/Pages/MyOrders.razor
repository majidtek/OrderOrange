@page "/orders"
@inject ApiClient Api
@inject LanguageService L
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>OrderOrange — My orders</PageTitle>

<PageHeader Title="@L["orders.title"]" Subtitle="@L["orders.subtitle"]" />

@if (_orders is null)
{
    <Loader FullPage="true" />
}
else if (_orders.Count == 0)
{
    <EmptyState Emoji="🍽️" Title="@L["orders.none"]" Subtitle="@L["orders.noneHint"]">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" Href="/">@L["orders.browse"]</MudButton>
    </EmptyState>
}
else
{
    <AutoRefresh OnRefresh="Reload" Seconds="10" />
    <MudGrid Spacing="3">
        @foreach (var order in _orders)
        {
            var o = order;
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 rounded-xl d-flex flex-column" Style="height: 100%; gap: 6px;">
                    <div class="d-flex align-center" style="gap: 8px;">
                        <div style="font-size: 28px;">@o.RestaurantLogoEmoji</div>
                        <div class="flex-grow-1" style="min-width: 0;">
                            <MudText Typo="Typo.subtitle2">@StoreText.Name(o.RestaurantName, L)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@o.Number · @Fmt.TimeAgo(o.PlacedAt, L)</MudText>
                        </div>
                        <StatusChip Status="@o.Status" />
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @string.Join(", ", o.Items.Select(i => $"{i.Quantity}× {L.Product(i.Name)}"))
                    </MudText>
                    <div class="d-flex align-center mt-auto pt-2" style="gap: 8px;">
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="flex-grow-1">@Fmt.Rial(o.Total)</MudText>
                        @if (o.Status == OrderStatus.Delivered && !o.HasReview)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Star" OnClick="@(() => Review(o))">@L["orders.rate"]</MudButton>
                        }
                        @if (o.Status == OrderStatus.Delivered)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       OnClick="@(() => Nav.NavigateTo(StorePath.For(o.RestaurantId)))">@L["orders.reorder"]</MudButton>
                        }
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="@(() => Nav.NavigateTo($"/track/{o.Id}"))">
                            @(IsActive(o) ? L["orders.track"] : L["common.details"])
                        </MudButton>
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
    <InfiniteScroll OnLoadMore="LoadMore" HasMore="_hasMore" />
}

@code {
    private const int PageSize = 20;

    private List<OrderDto>? _orders;
    private bool _hasMore = true;

    protected override Task OnInitializedAsync() => Reload();

    /// <summary>Refreshes the window we've already scrolled through (poll-friendly).</summary>
    private async Task Reload()
    {
        var take = Math.Min(50, Math.Max(PageSize, _orders?.Count ?? PageSize));
        var items = await Api.GetMyOrdersAsync(0, take) ?? [];
        _orders = items;
        _hasMore = items.Count >= take;
    }

    private async Task LoadMore()
    {
        if (_orders is null) return;
        var page = await Api.GetMyOrdersAsync(_orders.Count, PageSize) ?? [];
        _orders.AddRange(page);
        _hasMore = page.Count == PageSize;
    }

    private static bool IsActive(OrderDto o) =>
        o.Status is not (OrderStatus.Delivered or OrderStatus.Cancelled or OrderStatus.Rejected);

    private async Task Review(OrderDto order)
    {
        var parameters = new DialogParameters<ReviewDialog> { { d => d.Order, order } };
        var dialog = await Dialogs.ShowAsync<ReviewDialog>(L["track.rate"], parameters, new DialogOptions { NoHeader = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled == false)
        {
            Snackbar.Add(L["common.thanksFeedback"], Severity.Success);
            await Reload();
        }
    }
}
