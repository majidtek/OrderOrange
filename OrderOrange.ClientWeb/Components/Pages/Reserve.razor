    /// <summary>Optimal-string-alignment distance (insert / delete / replace / adjacent swap),
    /// cut off once it passes <paramref name="max"/> so long words cost nothing.</summary>
    private static int Distance(string a, string b, int max)
    {
        if (Math.Abs(a.Length - b.Length) > max) return max + 1;
        var d = new int[a.Length + 1, b.Length + 1];
        for (var i = 0; i <= a.Length; i++) d[i, 0] = i;
        for (var j = 0; j <= b.Length; j++) d[0, j] = j;
        for (var i = 1; i <= a.Length; i++)
        {
            var rowMin = int.MaxValue;
            for (var j = 1; j <= b.Length; j++)
            {
                var cost = a[i - 1] == b[j - 1] ? 0 : 1;
                var v = Math.Min(Math.Min(d[i - 1, j] + 1, d[i, j - 1] + 1), d[i - 1, j - 1] + cost);
                if (i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1]) v = Math.Min(v, d[i - 2, j - 2] + 1);
                d[i, j] = v;
                rowMin = Math.Min(rowMin, v);
            }
            if (rowMin > max) return max + 1;
        }
        return d[a.Length, b.Length];
    }

    /// <summary>
    /// The search alphabet: lower-case, no accents, Arabic/Persian letter variants unified
    /// (ي/ی, ك/ک, ة/ه, أإآ/ا, ZWNJ dropped), and the usual Latin spellings of Persian
    /// sounds folded together (q/k, kh/k, gh/g, oo/ou/u, ee/i, doubled letters).
    /// </summary>
    private static string Fold(string? s)
    {
        if (string.IsNullOrEmpty(s)) return "";
        var d = s.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(d.Length);
        foreach (var ch in d)
        {
            var cat = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch);
            if (cat == System.Globalization.UnicodeCategory.NonSpacingMark) continue;       // accents + Arabic harakat
            sb.Append(ch switch
            {
                'ي' or 'ی' or 'ئ' => 'ی', 'ك' or 'ک' => 'ک', 'ة' or 'ۀ' => 'ه',
                'أ' or 'إ' or 'آ' or 'ٱ' => 'ا', 'ؤ' => 'و', 'ى' => 'ی',
                '‌' or '‍' or 'ـ' => ' ',
                '-' or '_' or '.' or ',' or '،' or '/' or '(' or ')' or '&' or '+' => ' ',
                _ => char.ToLowerInvariant(ch),
            });
        }
        var f = sb.ToString();
        // Latin spellings of Persian/Arabic sounds
        f = f.Replace("kh", "k").Replace("gh", "g").Replace("q", "k").Replace("c", "k")
             .Replace("oo", "u").Replace("ou", "u").Replace("ee", "i").Replace("ph", "f").Replace("w", "v");
        // doubled letters: "kabbab" ≈ "kabab"
        var o = new System.Text.StringBuilder(f.Length);
        foreach (var ch in f) if (o.Length == 0 || o[^1] != ch || ch == ' ') o.Append(ch);
        return System.Text.RegularExpressions.Regex.Replace(o.ToString(), @"\s+", " ").Trim();
    }

    private MenuItemDto? ItemById(int id) => _info?.Menu?.SelectMany(c => c.Items).FirstOrDefault(i => i.Id == id);
    private int Count => _pending.Values.Sum();
    private decimal PendingSum => _pending.Sum(p => (ItemById(p.Key)?.FinalPrice ?? 0m) * p.Value);

    private bool _catsWatched;

    /// <summary>
    /// True only once this component renders on a LIVE circuit. The page is prerendered
    /// on the server first, so the guest sees the menu — and the + buttons — seconds
    /// before a tap can reach anyone. Until then the buttons spin instead of pretending
    /// (Majed 2026-09-07: "user can not add item after some time, add loader for plus").
    /// OnAfterRender never runs during prerendering, which is exactly what makes this work.
    /// </summary>
    private bool _ready;

    /// <summary>Once the group row exists, let the browser watch its overflow for the arrows.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_ready)
        {
            _ready = true;
            StateHasChanged();
        }
        if (_catsWatched || _loading || _info?.Menu is not { Count: > 0 }) return;
        _catsWatched = true;
        try { await JS.InvokeVoidAsync("mfQm.watchCats"); } catch (JSException) { }
        if (!_searchBound)
        {
            _searchBound = true;
            _self ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("mfQm.bindSearch", "qm-search-input", _self); } catch (JSException) { }
        }
    }

    /// <summary>The language button lives in the layout; without this the page kept its old
    /// names until the next tap re-rendered it ("on change language product name not change
    /// until I add item to basket" — Majed 2026-09-08).</summary>
    private void OnLangChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnLangChanged;
        _info = await Api.GetReserveInfoAsync(Code);
        _loading = false;
        if (_info is null) return;

        // Is the store asking its guests anything? Decides the survey button after an order.
        if (_info.StoreId > 0)
            _ = Task.Run(async () =>
            {
                try { _hasSurvey = await Api.GetPublicSurveyAsync(_info.StoreId) is not null; }
                catch { }
                await InvokeAsync(StateHasChanged);
            });

        // The app bar wears THIS store's face while the guest is at the table.
        TableBrand.Set(_info.NameFor(L.Locale), _info.LogoData, _info.LogoEmoji);

        // Paint the menu the moment it is here. Blazor renders when this method's whole
        // task completes, so awaiting the chat history first left the guest staring at
        // the loader until an unrelated call returned — and only a tap woke it up.
        StateHasChanged();

        // The chat catches up on its own time; it holds nothing back.
        _ = PrimeChatAsync();
    }

    /// <summary>History first so old replies never count as "new", then the poll.</summary>
    private async Task PrimeChatAsync()
    {
        try
        {
            var history = await Api.GetTableChatAsync(Code) ?? [];
            _lastChatId = history.Count > 0 ? history[^1].Id : 0;
            _chatPoll = new System.Threading.Timer(async _ => await PollChat(), null, 4000, 4000);
        }
        catch { /* the menu is what the guest came for; chat can wait for the next poll */ }
    }

    private async Task PollChat()
    {
        try
        {
            var fresh = await Api.GetTableChatAsync(Code, _lastChatId);
            if (fresh is not { Count: > 0 }) return;
            var newFromStore = 0;
            foreach (var m in fresh)
            {
                _lastChatId = Math.Max(_lastChatId, m.Id);
                if (m.From == "store") newFromStore++;
            }
            if (newFromStore > 0)
            {
                await InvokeAsync(() => { _chatUnread += newFromStore; StateHasChanged(); });
                try { await JS.InvokeVoidAsync("mfDing"); } catch { }
            }
        }
        catch { /* a missed poll is the next poll's problem */ }
    }

    public void Dispose()
    {
        L.Changed -= OnLangChanged;
        _chatPoll?.Dispose();
        _self?.Dispose();
        TableBrand.Clear();
    }

    private void Bump(MenuItemDto item, int delta)
    {
        var next = _pending.GetValueOrDefault(item.Id) + delta;
        if (next <= 0) _pending.Remove(item.Id);
        else _pending[item.Id] = Math.Min(next, 20);
    }

    /// <summary>The store's name in its OTHER tongue for the masthead's second line —
    /// Arabic under an English name, English under an Arabic one; nothing if they match.</summary>
    private string? AltName(TableReserveInfoDto info)
    {
        var main = info.NameFor(L.Locale);
        foreach (var code in new[] { L.Locale == "ar" ? "en" : "ar", "fa", "en" })
        {
            if (info.StoreNames is not null && info.StoreNames.TryGetValue(code, out var n)
                && n.Length > 0 && !string.Equals(n, main, StringComparison.OrdinalIgnoreCase))
                return n;
        }
        return null;
    }

    // ---------- The guest's invoice PDF ----------
    private bool _pdfBusy;
    private bool _pdfOk;
    private int _pdfPct = -1;   // -1: the server is still drawing; 0–100: bytes arriving
    private string? _pdfMsg;
    private DotNetObjectReference<Reserve>? _self;

    /// <summary>Called from mf-export.js as the file streams in.</summary>
    [JSInvokable]
    public void PdfProgress(int percent)
    {
        _pdfPct = percent;
        InvokeAsync(StateHasChanged);
    }

    private async Task DownloadInvoicePdf()
    {
        if (_sent?.InvoicePdfUrl is not { Length: > 0 } url || _pdfBusy) return;
        _pdfBusy = true;
        _pdfPct = -1;
        _pdfMsg = null;
        _self ??= DotNetObjectReference.Create(this);
        try
        {
            var ok = await JS.InvokeAsync<bool>("mfExport.fetchAndSave", url, $"invoice-{_sent.TabId}.pdf", "application/pdf", _self);
            _pdfOk = ok;
            _pdfMsg = ok ? L["qo.pdfReady"] : L["qo.pdfFail"];
        }
        catch (JSException)
        {
            _pdfOk = false;
            _pdfMsg = L["qo.pdfFail"];
        }
        finally { _pdfBusy = false; }
    }

    private async Task Send()
    {
        if (Count == 0) return;
        _busy = true;
        _error = null;
        try
        {
            var items = _pending.Select(p => new PlaceOrderItem(p.Key, p.Value, null)).ToList();
            var (result, error) = await Api.SubmitTableOrderAsync(Code, new PublicTableOrderRequest(items));
            if (result is null) { _error = error ?? L["common.saveFail"]; return; }
            _sent = result;
            _pending.Clear();
        }
        finally { _busy = false; }
    }
}
