@namespace OrderOrange.ClientCore.Components

<MudPaper Elevation="0" Outlined="true" Class="pa-4 rounded-xl d-flex align-center" Style="gap: 14px; height: 100%;">
    <MudAvatar Color="@Color" Variant="Variant.Filled" Size="Size.Large">
        <MudIcon Icon="@Icon" />
    </MudAvatar>
    <div style="min-width: 0;">
        <MudText Typo="Typo.overline" Color="MudBlazor.Color.Secondary">@Label</MudText>
        @* Rendered as markup so money values can carry the inline rial symbol.
           Every Value passed in is app-computed text, never user input. *@
        <MudText Typo="Typo.h5" Style="line-height: 1.2;">@((MarkupString)Value)</MudText>
        @if (Hint is not null)
        {
            <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">@Hint</MudText>
        }
    </div>
</MudPaper>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Insights;
    [Parameter] public Color Color { get; set; } = Color.Primary;
}
