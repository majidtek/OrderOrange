@inject LanguageService L
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IDisposable

@* One chat thread with text, photos, files and voice notes — the team-chat pane made
   reusable, for the admin ↔ partner chat (Majed 2026-10-14: "I need to chat with partner
   as admin. They can send me message and photo … and voice"). The page hands in how to
   sync, send, edit and delete; "mine" is the side MineIsAdmin says. Needs mf-voice.js
   (mfImage, mfCam, mfFile, mfBlob, mfVoice). *@

<div class="wa-pane dchat @HeaderClass">
    <div class="wa-head">
        @if (OnBack.HasDelegate)
        {
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => OnBack.InvokeAsync())" />
        }
        <span class="ava c@(Math.Abs(ThreadKey) % 8)">@Avatar</span>
        <div class="who">
            <b>@Title</b>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <small>@Subtitle</small>
            }
        </div>
        @HeaderExtra
    </div>

    <div class="wa-msgs" id="@_msgsId">
        @if (_messages.Count == 0 && !_loading)
        {
            <div class="qc-empty">@Empty</div>
        }
        @{
            DateTime? lastDay = null;
        }
        @foreach (var m in _messages)
        {
            var msg = m;
            var own = msg.FromAdmin == MineIsAdmin;
            @if (lastDay != msg.At.Date)
            {
                lastDay = msg.At.Date;
                <div class="wa-date"><span>@DayLabel(msg.At)</span></div>
            }
            <div class="qc-bubble @(own ? "me" : "them") @(msg.Deleted ? "gone" : "")">
                @if (!msg.Deleted)
                {
                    <button type="button" class="qc-dots" @onclick="@(() => ToggleActions(msg))"
                            @onclick:stopPropagation="true">⋮</button>
                }
                @if (!string.IsNullOrEmpty(msg.UserName) && (!own || ShowOwnNames))
                {
                    <span class="dchat-name">@(msg.FromAdmin ? "OrderOrange" : msg.UserName)</span>
                }
                @if (msg.Deleted)
                {
                    <span class="delstub">🚫 @L["qc.deleted"]</span>
                }
                else
                {
                    @if (msg.ReplyPreview is not null)
                    {
                        <span class="qc-quote">@msg.ReplyPreview</span>
                    }
                    @if (msg.Image is not null)
                    {
                        <img class="qc-img" src="@msg.Image" alt="" loading="lazy"
                             @onclick="@(() => _viewImage = msg.Image)" @onclick:stopPropagation="true" />
                    }
                    @if (msg.Audio is not null)
                    {
                        <audio controls preload="metadata" src="@msg.Audio"></audio>
                    }
                    @if (msg.File is not null)
                    {
                        <a class="qc-file" href="@msg.File" download="@msg.FileName" target="_blank"
                           @onclick:stopPropagation="true">📄 <span>@msg.FileName</span></a>
                    }
                    @if (!string.IsNullOrWhiteSpace(msg.Text))
                    {
                        @* "§key" is a system line (the welcome) — shown in the reader's own language. *@
                        <span><LinkText Text="@(msg.Text.StartsWith('§') ? L[msg.Text[1..]] : msg.Text)" /></span>
                    }
                }
                <small>
                    @if (msg.EditedAt is not null && !msg.Deleted)
                    {
                        <i class="ed">@L["qc.edited"] · </i>
                    }
                    @Fmt.Time(msg.At)
                </small>
                @if (_actionsFor == msg.Id && !msg.Deleted)
                {
                    <div class="qc-actions" @onclick:stopPropagation="true">
                        <button type="button" @onclick="@(() => BeginReply(msg))"><MudIcon Icon="@Icons.Material.Filled.Reply" Style="width:16px;height:16px;" /> @L["qc.reply"]</button>
                        @if (own && msg.Audio is null && msg.Image is null && msg.File is null)
                        {
                            <button type="button" @onclick="@(() => BeginEdit(msg))"><MudIcon Icon="@Icons.Material.Filled.Edit" Style="width:16px;height:16px;" /> @L["qc.edit"]</button>
                        }
                        @if (own)
                        {
                            <button type="button" class="danger" @onclick="@(() => DeleteMessage(msg))"><MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Style="width:16px;height:16px;" /> @L["qc.delete"]</button>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (_editingId is not null)
    {
        <div class="qc-replybar">
            <div class="q"><b>✏️ @L["qc.edit"]</b></div>
            <button type="button" @onclick="CancelEdit">✕</button>
        </div>
    }
    else if (_replyTo is not null)
    {
        <div class="qc-replybar">
            <div class="q"><b>@L["qc.reply"]</b><span>@PreviewOf(_replyTo)</span></div>
            <button type="button" @onclick="@(() => _replyTo = null)">✕</button>
        </div>
    }

    @if (_uploadPct >= 0)
    {
        <div class="qc-upload">
            <span class="ic"><MudIcon Icon="@Icons.Material.Filled.CloudUpload" Style="width:17px;height:17px;" /></span>
            <span class="meta">
                <small>@L["qc.uploading"]</small>
                <span class="bar"><span class="fill" style="width:@(_uploadPct)%"></span></span>
            </span>
            <b class="pct">@_uploadPct%</b>
        </div>
    }
    <div class="wa-input">
        @if (_recording)
        {
            <div class="qc-rec">
                <span class="dot"></span> @L["qc.recording"]
                <button type="button" class="x" @onclick="CancelVoice">✕</button>
            </div>
            <button type="button" class="qc-mic on" @onclick="StopVoice"><MudIcon Icon="@Icons.Material.Filled.Send" Class="qc-send-ico" Style="width:20px;height:20px;" /></button>
        }
        else
        {
            @if (_editingId is null)
            {
                <div class="qc-attachwrap">
                    <button type="button" class="qc-mic cam" title="@L["qc.gallery"]" @onclick="@(() => _attachOpen = !_attachOpen)">
                        <MudIcon Icon="@(_attachOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)" Style="width:18px;height:18px;" />
                    </button>
                    @if (_attachOpen)
                    {
                        <div class="qc-attach">
                            <button type="button" @onclick="@(() => PickImage(true))">
                                <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Style="width:16px;height:16px;" /> @L["qc.camera"]
                            </button>
                            <button type="button" @onclick="@(() => PickImage(false))">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Style="width:16px;height:16px;" /> @L["qc.gallery"]
                            </button>
                            <button type="button" @onclick="PickFile">
                                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Style="width:16px;height:16px;" /> @L["qc.file"]
                            </button>
                        </div>
                    }
                </div>
            }
            <input id="@_inputId" @bind="_text" @bind:event="oninput" maxlength="500" placeholder="@L["qc.placeholder"]"
                   @onkeydown="@(e => { if (e.Key == "Enter") _ = Send(); })" />
            @if (string.IsNullOrWhiteSpace(_text) && _editingId is null)
            {
                <button type="button" class="qc-mic" title="🎤" @onclick="StartVoice"><MudIcon Icon="@Icons.Material.Filled.Mic" Style="width:20px;height:20px;" /></button>
            }
            else
            {
                <button type="button" class="qc-mic on" @onclick="Send"><MudIcon Icon="@(_editingId is null ? Icons.Material.Filled.Send : Icons.Material.Filled.Check)" Class="qc-send-ico" Style="width:20px;height:20px;" /></button>
            }
        }
    </div>
</div>

@if (_viewImage is not null)
{
    <div class="qc-lightbox" @onclick="@(() => _viewImage = null)">
        <img src="@_viewImage" alt="" />
        <button type="button" class="x">✕</button>
    </div>
}

@code {
    /// <summary>Changes when the thread does (e.g. another store picked) — resets everything.</summary>
    [Parameter] public int ThreadKey { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string Avatar { get; set; } = "💬";
    [Parameter] public string Empty { get; set; } = "";
    [Parameter] public string HeaderClass { get; set; } = "";
    [Parameter] public RenderFragment? HeaderExtra { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    /// <summary>True on the admin's screen: messages FromAdmin are "mine".</summary>
    [Parameter] public bool MineIsAdmin { get; set; }
    /// <summary>Several people share one side (the store's team) — name them on my side too.</summary>
    [Parameter] public bool ShowOwnNames { get; set; }

    [Parameter, EditorRequired] public Func<int, long, Task<CommunityChatSyncDto?>> SyncFn { get; set; } = default!;
    [Parameter, EditorRequired] public Func<SendTableChatRequest, Task<(CommunityChatMessageDto? message, string? error)>> SendFn { get; set; } = default!;
    [Parameter, EditorRequired] public Func<int, string, Task<(CommunityChatMessageDto? message, string? error)>> EditFn { get; set; } = default!;
    [Parameter, EditorRequired] public Func<int, Task<(CommunityChatMessageDto? message, string? error)>> DeleteFn { get; set; } = default!;
    /// <summary>Told after every sync, e.g. to refresh an inbox's unread badges.</summary>
    [Parameter] public EventCallback OnSynced { get; set; }

    private readonly string _msgsId = "dc-msgs-" + Guid.NewGuid().ToString("N")[..6];
    private readonly string _inputId = "dc-in-" + Guid.NewGuid().ToString("N")[..6];
    private readonly List<CommunityChatMessageDto> _messages = [];
    private int _lastId;
    private long _stamp;
    private int? _actionsFor;
    private int? _editingId;
    private CommunityChatMessageDto? _replyTo;
    private string? _viewImage;
    private bool _attachOpen;
    private int _uploadPct = -1;
    private string _text = "";
    private bool _recording;
    private bool _loading = true;
    private int _shownKey = int.MinValue;
    private System.Threading.Timer? _poll;

    private string DayLabel(DateTime at) =>
        at.Date == Fmt.ServerToday ? L["qc.today"]
        : at.Date == Fmt.ServerToday.AddDays(-1) ? L["qc.yesterday"]
        : Fmt.Date(at);

    private static string PreviewOf(CommunityChatMessageDto msg) =>
        !string.IsNullOrWhiteSpace(msg.Text)
            ? (msg.Text.Length > 60 ? msg.Text[..60] + "…" : msg.Text)
            : msg.Audio is not null ? "🎤"
            : msg.Image is not null ? "📷"
            : msg.File is not null ? $"📄 {msg.FileName}"
            : "…";

    protected override async Task OnParametersSetAsync()
    {
        if (_shownKey == ThreadKey) return;
        _shownKey = ThreadKey;
        _messages.Clear();
        _lastId = 0;
        _stamp = 0;
        _loading = true;
        _replyTo = null;
        _editingId = null;
        _poll?.Dispose();
        await Sync();
        _loading = false;
        _poll = new System.Threading.Timer(async _ => await Sync(), null, 4000, 4000);
        await Scroll();
    }

    private async Task Sync()
    {
        try
        {
            var sync = await SyncFn(_lastId, _stamp);
            if (sync is null) return;
            var dirty = sync.New.Count > 0 || sync.Changed.Count > 0;
            _stamp = sync.Stamp;
            foreach (var changed in sync.Changed)
            {
                var i = _messages.FindIndex(x => x.Id == changed.Id);
                if (i >= 0) _messages[i] = changed;
            }
            foreach (var m in sync.New)
            {
                if (_messages.Any(x => x.Id == m.Id)) continue;
                _messages.Add(m);
                _lastId = Math.Max(_lastId, m.Id);
            }
            if (dirty) await InvokeAsync(StateHasChanged);
            if (sync.New.Count > 0) await Scroll();
            if (OnSynced.HasDelegate) await InvokeAsync(() => OnSynced.InvokeAsync());
        }
        catch { }
    }

    private void ToggleActions(CommunityChatMessageDto msg) =>
        _actionsFor = msg.Deleted || _actionsFor == msg.Id ? null : msg.Id;

    private async Task BeginReply(CommunityChatMessageDto msg)
    {
        _replyTo = msg;
        _editingId = null;
        _actionsFor = null;
        await FocusInput();
    }

    private async Task BeginEdit(CommunityChatMessageDto msg)
    {
        _editingId = msg.Id;
        _replyTo = null;
        _text = msg.Text;
        _actionsFor = null;
        await FocusInput();
    }

    private void CancelEdit()
    {
        _editingId = null;
        _text = "";
    }

    private async Task FocusInput()
    {
        try { await JS.InvokeVoidAsync("eval", $"setTimeout(function(){{var e=document.getElementById('{_inputId}'); if(e) e.focus();}}, 60)"); }
        catch { }
    }

    private async Task Scroll()
    {
        try { await JS.InvokeVoidAsync("eval", $"setTimeout(function(){{var e=document.getElementById('{_msgsId}'); if(e) e.scrollTop=e.scrollHeight;}}, 30)"); }
        catch { }
    }

    private async Task DeleteMessage(CommunityChatMessageDto msg)
    {
        _actionsFor = null;
        var (updated, _) = await DeleteFn(msg.Id);
        Replace(updated);
    }

    private void Replace(CommunityChatMessageDto? updated)
    {
        if (updated is null) return;
        var i = _messages.FindIndex(x => x.Id == updated.Id);
        if (i >= 0) _messages[i] = updated;
    }

    /// <summary>Adds what I just sent, or says why it was refused.</summary>
    private async Task Added((CommunityChatMessageDto? message, string? error) result)
    {
        if (result.message is { } message)
        {
            if (!_messages.Any(x => x.Id == message.Id)) _messages.Add(message);
            _lastId = Math.Max(_lastId, message.Id);
            await Scroll();
        }
        else
        {
            Snackbar.Add(L.ServerError(result.error) ?? L["common.error"], Severity.Error);
        }
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_text)) return;
        var text = _text.Trim();
        _text = "";

        if (_editingId is { } editId)
        {
            _editingId = null;
            var (updated, _) = await EditFn(editId, text);
            Replace(updated);
            return;
        }

        var replyId = _replyTo?.Id;
        _replyTo = null;
        await Added(await SendFn(new SendTableChatRequest(text, null, null, replyId)));
    }

    private async Task PickImage(bool fromCamera)
    {
        _attachOpen = false;
        string? meta;
        if (fromCamera)
        {
            meta = await JS.InvokeAsync<string?>("mfCam.open");
            if (meta == "no-cam") meta = await JS.InvokeAsync<string?>("mfImage.pick", true);
        }
        else
        {
            meta = await JS.InvokeAsync<string?>("mfImage.pick", false);
        }
        if (string.IsNullOrEmpty(meta)) return;
        if (meta == "too-big") { Snackbar.Add(L["common.error"], Severity.Warning); return; }
        _uploadPct = 0;
        try
        {
            var parked = System.Text.Json.JsonDocument.Parse(meta);
            var data = await PullChunks(parked.RootElement.GetProperty("id").GetString()!,
                                        parked.RootElement.GetProperty("size").GetInt32());
            if (string.IsNullOrEmpty(data)) return;
            var replyId = _replyTo?.Id;
            _replyTo = null;
            await Added(await SendFn(new SendTableChatRequest("", null, data, replyId)));
            await JS.InvokeVoidAsync("mfImage.clearPending");
        }
        finally { _uploadPct = -1; }
    }

    private async Task PickFile()
    {
        _attachOpen = false;
        var raw = await JS.InvokeAsync<string?>("mfFile.pick");
        if (string.IsNullOrEmpty(raw)) return;
        if (raw == "too-big") { Snackbar.Add(L["common.error"], Severity.Warning); return; }
        _uploadPct = 0;
        try
        {
            var doc = System.Text.Json.JsonDocument.Parse(raw);
            var name = doc.RootElement.GetProperty("name").GetString();
            var data = await PullChunks(doc.RootElement.GetProperty("id").GetString()!,
                                        doc.RootElement.GetProperty("size").GetInt32());
            if (string.IsNullOrEmpty(data)) return;
            await Added(await SendFn(new SendTableChatRequest("", null, null, null, data, name)));
        }
        finally { _uploadPct = -1; }
    }

    private async Task<string?> PullChunks(string id, int size)
    {
        var sb = new System.Text.StringBuilder(size);
        for (var offset = 0; offset < size; offset += 50000)
        {
            sb.Append(await JS.InvokeAsync<string>("mfBlob.chunk", id, offset, 50000));
            _uploadPct = (int)Math.Min(99, (offset + 50000) * 100L / size);
            StateHasChanged();
        }
        await JS.InvokeVoidAsync("mfBlob.end", id);
        return sb.Length == size ? sb.ToString() : null;
    }

    private async Task StartVoice()
    {
        if (await JS.InvokeAsync<bool>("mfVoice.start")) _recording = true;
        else Snackbar.Add(L["chat.micDenied"], Severity.Warning);
    }

    private async Task CancelVoice()
    {
        await JS.InvokeVoidAsync("mfVoice.cancel");
        _recording = false;
    }

    private async Task StopVoice()
    {
        _recording = false;
        var data = await JS.InvokeAsync<string?>("mfVoice.stop");
        if (data is null) return;
        if (data == "too-big") { Snackbar.Add(L["common.error"], Severity.Warning); return; }
        await Added(await SendFn(new SendTableChatRequest("", data)));
    }

    public void Dispose() => _poll?.Dispose();
}
