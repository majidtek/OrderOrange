@namespace OrderOrange.ClientCore.Components

<div class="pg-head d-flex align-center flex-wrap mb-5" style="gap: 12px;">
    <div class="flex-grow-1">
        <MudText Typo="Typo.h4">@Title</MudText>
        @if (Subtitle is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@Subtitle</MudText>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="d-flex align-center" style="gap: 8px;">@Actions</div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
