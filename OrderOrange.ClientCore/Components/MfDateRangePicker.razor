@namespace OrderOrange.ClientCore.Components
@inject IDialogService Dialogs

@* Range twin of MfDatePicker: one read-only field showing "start – end", calendar in the
   top-level dialog layer. DateRange/DateRangeChanged so @bind-DateRange (and :after) work. *@
<MudTextField T="string" Value="@Text" ReadOnly="true" Label="@Label" Variant="Variant" Margin="Margin"
              Class="@("mf-date mf-date-range " + Class)" Style="@Style" Disabled="Disabled"
              Placeholder="@Placeholder"
              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.DateRange"
              OnAdornmentClick="OpenAsync" @onclick="OpenAsync"
              Clearable="Clearable" OnClearButtonClick="ClearAsync" />

@code {
    [Parameter] public DateRange? DateRange { get; set; }
    [Parameter] public EventCallback<DateRange?> DateRangeChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string DateFormat { get; set; } = "yyyy-MM-dd";
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public DateTime? MinDate { get; set; }
    [Parameter] public DateTime? MaxDate { get; set; }
    [Parameter] public string? PlaceholderStart { get; set; }
    [Parameter] public string? PlaceholderEnd { get; set; }

    private string F(DateTime? d) => d?.ToString(DateFormat, System.Globalization.CultureInfo.InvariantCulture) ?? "";

    private string Text => DateRange is { Start: not null } or { End: not null }
        ? $"{F(DateRange!.Start)} – {F(DateRange.End)}"
        : "";

    private string? Placeholder => string.IsNullOrEmpty(PlaceholderStart) && string.IsNullOrEmpty(PlaceholderEnd)
        ? null
        : $"{PlaceholderStart} – {PlaceholderEnd}";

    private async Task OpenAsync()
    {
        if (Disabled) return;
        var parameters = new DialogParameters
        {
            [nameof(CalendarDialog.Range)] = true,
            [nameof(CalendarDialog.DateRange)] = DateRange,
            [nameof(CalendarDialog.MinDate)] = MinDate,
            [nameof(CalendarDialog.MaxDate)] = MaxDate,
        };
        var options = new DialogOptions { NoHeader = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true, BackdropClick = true };
        var dialog = await Dialogs.ShowAsync<CalendarDialog>("", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: DateRange picked })
        {
            DateRange = picked;
            await DateRangeChanged.InvokeAsync(picked);
        }
    }

    private async Task ClearAsync()
    {
        if (DateRange is null) return;
        DateRange = null;
        await DateRangeChanged.InvokeAsync(null);
    }
}
