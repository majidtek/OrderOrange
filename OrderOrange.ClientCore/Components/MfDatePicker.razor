@namespace OrderOrange.ClientCore.Components
@inject IDialogService Dialogs

@* A date field whose calendar opens in the top-level dialog layer (see CalendarDialog).
   Same surface as MudDatePicker for what the apps use: Date/DateChanged (so @bind-Date
   works), Label, DateFormat, Variant, Margin, Class, Style, Clearable, Min/MaxDate. *@
<MudTextField T="string" Value="@Text" ReadOnly="true" Label="@Label" Variant="Variant" Margin="Margin"
              Class="@("mf-date " + Class)" Style="@Style" Disabled="Disabled"
              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
              OnAdornmentClick="OpenAsync" @onclick="OpenAsync"
              Clearable="Clearable" OnClearButtonClick="ClearAsync" />

@code {
    [Parameter] public DateTime? Date { get; set; }
    [Parameter] public EventCallback<DateTime?> DateChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string DateFormat { get; set; } = "yyyy-MM-dd";
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public DateTime? MinDate { get; set; }
    [Parameter] public DateTime? MaxDate { get; set; }

    private string Text => Date?.ToString(DateFormat, System.Globalization.CultureInfo.InvariantCulture) ?? "";

    private async Task OpenAsync()
    {
        if (Disabled) return;
        var parameters = new DialogParameters
        {
            [nameof(CalendarDialog.Range)] = false,
            [nameof(CalendarDialog.Date)] = Date,
            [nameof(CalendarDialog.MinDate)] = MinDate,
            [nameof(CalendarDialog.MaxDate)] = MaxDate,
        };
        var options = new DialogOptions { NoHeader = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true, BackdropClick = true };
        var dialog = await Dialogs.ShowAsync<CalendarDialog>("", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: DateTime picked } && picked != Date)
        {
            Date = picked;
            await DateChanged.InvokeAsync(picked);
        }
    }

    private async Task ClearAsync()
    {
        if (Date is null) return;
        Date = null;
        await DateChanged.InvokeAsync(null);
    }
}
